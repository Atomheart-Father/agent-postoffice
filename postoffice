def backup(path):
    if path.exists():
        dst = LOGS / f"{path.name}.{time.strftime('%Y%m%d-%H%M%S')}.bak"
        LOGS.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, dst)
        return dst
    return None


def is_ours(cmd):
    return "claude_hook.sh" in cmd or ("postoffice" in cmd and cmd.rstrip().endswith(" hook"))


def cmd_install_claude(_a):
    s = Path.home() / ".claude" / "settings.json"
    s.parent.mkdir(parents=True, exist_ok=True)
    cfg = json.loads(s.read_text(encoding="utf-8")) if s.exists() and s.read_text().strip() else {}
    bk = backup(s)
    # Claude Code docs say async hooks are not timed out, but the settings schema documents a 600 s default
    # for command hooks; set an explicit long timeout so neither reading can kill the watcher after 10 min.
    ours = {"type": "command", "command": f'exec "{SELF}" hook', "asyncRewake": True, "timeout": HOOK_TIMEOUT}
    hooks = cfg.setdefault("hooks", {})
    for event, extra in (("Stop", {}), ("SessionStart", {"matcher": "startup|resume|clear|compact"})):
        groups = []
        for g in hooks.get(event, []):
            g = dict(g)
            g["hooks"] = [h for h in g.get("hooks", []) if not is_ours(h.get("command", ""))]
            if g["hooks"]:
                groups.append(g)
        groups.append(dict(extra, hooks=[ours]))
        hooks[event] = groups
    s.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"Claude Code 钩子已装入 {s}" + (f"（原文件备份：{bk}）" if bk else ""))


def cmd_uninstall_claude(_a):
    s = Path.home() / ".claude" / "settings.json"
    if not s.exists():
        return
    cfg = json.loads(s.read_text(encoding="utf-8"))
    backup(s)
    for event in ("Stop", "SessionStart"):
        groups = []
        for g in cfg.get("hooks", {}).get(event, []):
            g["hooks"] = [h for h in g.get("hooks", []) if not is_ours(h.get("command", ""))]
            if g["hooks"]:
                groups.append(g)
        if "hooks" in cfg:
            cfg["hooks"][event] = groups
            if not groups:
                del cfg["hooks"][event]
    if cfg.get("hooks") == {}:
        del cfg["hooks"]
    s.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print("已移除 Claude Code 收信钩子")


def opencode_config_dir():
    return Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "opencode"


def cmd_install_opencode(_a):
    d = opencode_config_dir()
    plug = d / "plugins"
    plug.mkdir(parents=True, exist_ok=True)
    shutil.copy2(REPO / "opencode" / "postoffice.ts", plug / "postoffice.ts")
    print(f"OpenCode 插件已装入 {plug / 'postoffice.ts'}（重启 OpenCode 生效）")
    # let OpenCode agents read/write the mailbox without a permission prompt each time
    for name in ("opencode.json", "opencode.jsonc"):
        cfgf = d / name
        if cfgf.exists():
            break
    else:
        cfgf = d / "opencode.json"
    try:
        cfg = json.loads(cfgf.read_text(encoding="utf-8")) if cfgf.exists() else {"$schema": "https://opencode.ai/config.json"}
    except ValueError:
        print(f"提示：{cfgf} 含注释，未自动修改。想免去读信时的权限确认，请在 permission.external_directory 里加："
              f'"{HOME}/**": "allow"')
        return
    perm = cfg.setdefault("permission", {})
    ext = perm.get("external_directory")
    if isinstance(ext, str):
        ext = {"*": ext}
    ext = ext or {}
    key = f"{HOME}/**"
    if ext.get(key) != "allow":
        bk = backup(cfgf)
        ext[key] = "allow"
        perm["external_directory"] = ext
        cfgf.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        print(f"已允许 OpenCode 读写 {HOME}（{cfgf}" + (f"，备份 {bk}）" if bk else "）"))


def cmd_install_skill(_a):
