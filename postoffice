def cmd_hook(_a):
    """Claude Code Stop / SessionStart hook (asyncRewake). Waits for mail; exit 2 wakes the session."""
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    tp = data.get("transcript_path")
    title = None
    if tp and Path(tp).exists():
        with open(tp, encoding="utf-8", errors="replace") as f:
            for line in f:
                if '"custom-title"' in line:
                    try:
                        title = json.loads(line).get("customTitle") or title
                    except ValueError:
                        pass
    if not ROUTES.exists():
        return 0
    routes = load_routes()
    all_boxes = boxes(routes)
    claude_boxes = {k: v for k, v in all_boxes.items() if "claude_hook" in v.get("methods", [])}
    identity, source = resolve_claude_identity(data)
    name = None
    if identity:                                     # rules 1-3: a stable identity was resolved
        bound = [k for k, v in claude_boxes.items() if v.get("claude_session") == identity]
        if len(bound) == 1:
            name = bound[0]
            if title and all_boxes[name].get("claude_title") != title:
                routes[name]["claude_title"] = title     # a rename no longer loses the session
                save_routes(routes)
                log("claude_hook.log", f"{name} 按身份 {identity}（{source}）认人，标题更新为「{title}」")
        elif len(bound) > 1:                         # one identity claimed by several boxes: recognize none
            if notify_identity_once(f"dup::{identity}", f"身份 {identity} 被多个信箱绑定，均不认领"):
                log("claude_hook.log", f"身份 {identity} 绑定多个信箱 {bound}，不认；已通知人")
            return 0
    if name is None:                                 # rules 2/3/4: try the current title (exactly one box)
        cands = [k for k, v in claude_boxes.items() if title and v.get("claude_title") == title]
        if len(cands) == 1:
            c = cands[0]
            bound = all_boxes[c].get("claude_session")
            if identity and not bound:               # rule 2: first title match with an identity → bind it
                routes[c]["claude_session"] = identity
                save_routes(routes)
                log("claude_hook.log", f"{c} 首次按标题匹配，绑定身份 {identity}（{source}）")
                name = c
            elif identity and bound and bound != identity:   # rule 3: same title, different identity
                if notify_identity_once(f"{identity}::{c}", f"{c} 已绑定别的会话（{bound}），本次 {identity} 不接管"):
                    log("claude_hook.log", f"同名不接管：{c} 已绑 {bound}，本次 {identity}；已通知人")
                return 0
            elif not identity and not bound:         # rule 4: no identity, title matches an unbound box
                log("claude_hook.log", f"{c} 身份解析不到，退回标题匹配")
                name = c
            elif not identity and bound:             # rule 4: title matches a bound box → do not silently claim
                if notify_identity_once(f"unresolved::{c}", f"{c} 已绑定 {bound}，但本次会话身份解析不到，不认领"):
                    log("claude_hook.log", f"{c} 已绑 {bound} 但身份解析不到；不认，已诊断通知")
                return 0
            else:                                    # identity == bound: already handled by rule 1
                name = c
    if not name:
        log("claude_hook.log", f"未登记会话「{title or ''}」" + (f" 身份={identity}" if identity else "") + "，不监视")
        return 0

    box = HOME / name
    pidf, seenf, alive = box / ".watch.pid", box / ".seen", box / ".watch_alive"
    me, owner = os.getpid(), os.getppid()
    try:
        old = int(pidf.read_text().strip())
        if old != me:
            os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    pidf.write_text(str(me))
    log("claude_hook.log", f"{name} 监视上岗 pid={me} owner={owner}")
    paused = False
    while True:
        try:
            if pidf.read_text().strip() != str(me):
                return 0                      # a newer watcher took over
        except OSError:
            return 0
        try:
            os.kill(owner, 0)
        except OSError:
            log("claude_hook.log", f"{name} 会话进程已退出，监视下岗")
            return 0
        alive.touch()
        r = boxes(load_routes()).get(name)
        if r is None:
            return 0
        if online(r):
            seen = read_lines(seenf)
            new = [p for p in pending(name) if str(p) not in seen]
            if new:
                if rate_ok(name):
                    # 只有抢到认领的那些才唤醒：抢不到说明投递方或撤回正在处理这封信，
                    # 忽略返回值就会变成「认领失败也照样唤醒」，那正是撤回要避免的事。
                    new = [p for p in new if claim_letter(name, p)]
                if new:
                    sys.stderr.write(reminder(name, new) + "\n")
                    with seenf.open("a") as f:
                        f.writelines(f"{p}\n" for p in new)
                    rate_mark(name)          # merged receipts: one wake counts once, however many letters
                    for p in new:
                        log("claude_hook.log", f"{name} 唤醒 {p.name}")
                    pidf.unlink(missing_ok=True)
                    return 2
                if not paused:
                    notify("联络总站：唤醒暂停", f"{name} 10 分钟内来信超过 {RATE_N} 封")
                    log("claude_hook.log", f"{name} 限流暂停")
                    paused = True
            else:
                paused = False
        time.sleep(POLL)


def cmd_postman(_a):
    """Delivers codex_queue / notify mailboxes and watches that hook/plugin mailboxes really got woken."""
    state = HOME / ".delivered.json"
    delivered = set(json.loads(state.read_text())) if state.exists() else set()
    throttled = set()
    failed_batches = set()
    log("postman.log", f"邮递员上岗 v{VERSION}")
    print(f"{now_str()} 邮递员上岗（{HOME}），Ctrl+C 停止", flush=True)

    wokef = HOME / ".woken.json"     # letter → time we saw it reminded (ACCEPTED); leaving inbox = CONSUMED
    woken = json.loads(wokef.read_text()) if wokef.exists() else {}

    def mark(key, reminded=True):
        delivered.add(key)
        state.write_text(json.dumps(sorted(delivered), ensure_ascii=False))
        if reminded:
            woken[key] = {"t": time.time(), "alerted": False}
            wokef.write_text(json.dumps(woken, ensure_ascii=False))

    def check_consumed(routes):
        changed = False
        for key in list(woken):
            p = Path(key)
            if not p.exists():                       # moved to done/ (or deleted): consumed
                del woken[key]
                changed = True
                continue
            w = woken[key]
            r = routes.get(p.parent.parent.name)
            if w["alerted"] or not r or not online(r) or time.time() - w["t"] < CONSUME_ALERT:
                continue
            if not needs_action(p):                  # 仅告知/回执/广播汇总: backlog only, never a nudge
                continue
            notify(f"联络总站：{p.parent.parent.name} 已提醒但 {CONSUME_ALERT // 60} 分钟未处理",
                   (field(p, "事由") or p.name) + "（会话可能没加载、卡住或在忙长任务）")
            log("postman.log", f"未处理 {p.parent.parent.name} {p.name}：提醒后 {CONSUME_ALERT // 60} 分钟仍在 inbox，已通知人")
            w["alerted"] = True
            changed = True
        if changed:
            wokef.write_text(json.dumps(woken, ensure_ascii=False))

    while True:
        try:
            full = load_routes()
            ensure_online_baseline(full)
            routes = boxes(full)
        except Exception as e:
            log("postman.log", f"routes.json 读取失败：{e}")
            time.sleep(POLL)
            continue
        try:
            oc_ok = set()
            ledger = HOME / "opencode_delivered.jsonl"
            if ledger.exists():
                for line in ledger.read_text(encoding="utf-8").splitlines():
                    try:
                        e = json.loads(line)
                        if e.get("result") in ("DELIVERED", "FAILED_FINAL"):
                            oc_ok.add(f"{e['box']}::{e['file']}")
                    except (ValueError, KeyError):
                        pass
            check_consumed(routes)
            process_alarms(routes)
            summarize_broadcasts(routes)
            process_alias_switches(routes)
            for name, r in routes.items():
                if not online(r):
                    continue                  # offline: letters wait, nobody is reminded
                method = r.get("methods", ["notify"])[0]
                if method in ("claude_hook", "opencode_plugin"):
                    for p in pending(name):
                        key = str(p)
                        if key in delivered:
                            continue
                        done = (key in read_lines(HOME / name / ".seen")) if method == "claude_hook" \
                            else (f"{name}::{p.name}" in oc_ok)
                        # count from when the letter landed OR when this box last came online, whichever is later,
                        # so offline time never counts against the 20-minute grace
                        start = max(p.stat().st_mtime, float(r.get("online_since", 0) or 0))
                        if done:
                            log("postman.log", f"{method} {name} {p.name} 已送达")
                        elif field(p, "闹钟："):
                            continue        # an alarm ringing while the session is legitimately busy
                                              # is normal; it waits in inbox/ without paging anyone
                        elif time.time() - start > GRACE:
                            notify(f"联络总站：{name} 20 分钟未被唤醒", field(p, "事由") or p.name)
                            log("postman.log", f"{method} {name} {p.name} 超 20 分钟未送达，已通知人")
                            mark(key, reminded=False)
                            continue
                        else:
                            continue
                        mark(key)
                    continue
                # codex_queue / notify: formal letters go out one at a time, receipts merge into one trailing block
                leftovers = [p for p in pending(name) if str(p) not in delivered]
                formal, receipts = mail_split(leftovers)
                if not formal and not receipts:
                    continue
                letter = formal[0] if formal else None
                # with a letter: only receipts that have waited long enough ride along; without one: all of them
                due = list(receipts) if letter is None \
                    else [p for p in receipts if time.time() - p.stat().st_mtime > RECEIPT_WAIT]
                if letter is None and not due:
                    continue
                if not rate_ok(name):
                    if name not in throttled:
                        notify("联络总站：投递暂停", f"{name} 10 分钟内信件过多")
                        log("postman.log", f"THROTTLE {name}")
                        throttled.add(name)
                    continue
                throttled.discard(name)
                group = ([letter] if letter else []) + due
                names = " ".join(p.name for p in group)
                sig = f"{name}::" + "|".join(p.name for p in group)
                # 同样只投认领成功的：抢不到的那几封这一轮不动，等下一轮
                group = [p for p in group if claim_letter(name, p)]
                if not group:
                    continue
                names = " ".join(p.name for p in group)
                sig = f"{name}::" + "|".join(p.name for p in group)
                ok = True
                try:
                    if method == "codex_queue":
                        cli = r.get("codex_cli") or find_codex()
                        res = subprocess.run([cli, "queue", "--thread", r["thread_id"], "--message", reminder(name, group)],
                                             capture_output=True, text=True, timeout=60)
                        ok = res.returncode == 0
                        log("postman.log", f"codex_queue {name} {names} rc={res.returncode} "
                                           f"{res.stdout.strip()[:200]} {res.stderr.strip()[:200]}")
                    else:
                        notify(f"联络总站：给 {name} 的新信",
                               (field(letter, "事由") or letter.name) if letter else f"{len(due)} 条回执")
                        log("postman.log", f"notify {name} {names}")
                except Exception as e:
                    ok = False
                    log("postman.log", f"投递异常 {name} {names}: {e}")
                if not ok:
                    # nothing in the batch is marked delivered, so every ID stays eligible for retry;
                    # tell the human once per batch signature (no rate tick, nothing was woken)
                    for p in group:
                        release_claim(name, p)   # nobody was woken, so let it be claimed again
                    if sig not in failed_batches:
                        failed_batches.add(sig)
                        notify("联络总站：投递失败", f"{name} {names}，将重试")
                    continue
                failed_batches.discard(sig)
                rate_mark(name)                  # one wake for the whole batch (a merged receipt block counts once)
                for p in group:
                    mark(str(p), reminded=(method == "codex_queue"))
        except Exception as e:
            log("postman.log", f"邮递员本轮异常（已忽略，继续）：{e}")
        time.sleep(POLL)


# ---------- installers (all idempotent, all back up first) ----------

def backup(path):
    if path.exists():
        dst = LOGS / f"{path.name}.{time.strftime('%Y%m%d-%H%M%S')}.bak"
        LOGS.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, dst)
        return dst
    return None


def is_ours(cmd):
    return "claude_hook.sh" in cmd or ("postoffice" in cmd and cmd.rstrip().endswith(" hook"))


def cmd_install_claude(_a):
    s = Path.home() / ".claude" / "settings.json"
    s.parent.mkdir(parents=True, exist_ok=True)
    cfg = json.loads(s.read_text(encoding="utf-8")) if s.exists() and s.read_text().strip() else {}
    bk = backup(s)
    # Claude Code docs say async hooks are not timed out, but the settings schema documents a 600 s default
    # for command hooks; set an explicit long timeout so neither reading can kill the watcher after 10 min.
    ours = {"type": "command", "command": f'exec "{SELF}" hook', "asyncRewake": True, "timeout": HOOK_TIMEOUT}
    hooks = cfg.setdefault("hooks", {})
    for event, extra in (("Stop", {}), ("SessionStart", {"matcher": "startup|resume|clear|compact"})):
        groups = []
        for g in hooks.get(event, []):
            g = dict(g)
            g["hooks"] = [h for h in g.get("hooks", []) if not is_ours(h.get("command", ""))]
            if g["hooks"]:
                groups.append(g)
        groups.append(dict(extra, hooks=[ours]))
        hooks[event] = groups
    s.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"Claude Code 钩子已装入 {s}" + (f"（原文件备份：{bk}）" if bk else ""))


def cmd_uninstall_claude(_a):
    s = Path.home() / ".claude" / "settings.json"
    if not s.exists():
        return
    cfg = json.loads(s.read_text(encoding="utf-8"))
    backup(s)
    for event in ("Stop", "SessionStart"):
        groups = []
        for g in cfg.get("hooks", {}).get(event, []):
            g["hooks"] = [h for h in g.get("hooks", []) if not is_ours(h.get("command", ""))]
            if g["hooks"]:
                groups.append(g)
        if "hooks" in cfg:
            cfg["hooks"][event] = groups
            if not groups:
                del cfg["hooks"][event]
    if cfg.get("hooks") == {}:
        del cfg["hooks"]
    s.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print("已移除 Claude Code 收信钩子")


def opencode_config_dir():
    return Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "opencode"


def link_postoffice_cli():
    """把 ~/.local/bin/postoffice 指回“执行本安装的那份 checkout”。

    装好的插件不在 checkout 里，它在 $XDG_CONFIG_HOME/opencode/plugins/ 下，只能通过这个 symlink
    找到写闹钟记录的那个 CLI —— CLI 本身单文件 Python 留在 checkout 里。所以谁装了这个插件，谁的
    CLI 就必须是它，否则插件版本与 CLI 版本会各走各的（改了插件却用着别的 checkout 的 CLI）。
    在 A checkout 里 install 再到 B 里 install，插件与 symlink 会一起切到 B。

    幂等：已经指着 SELF 就什么都不做。这不是新增状态文件，只是把 install.sh 早就在做的事
    （ln -sfn）也放进 `postoffice install opencode`，好让单独跑这个子命令也自洽。
    """
    link = Path.home() / ".local" / "bin" / "postoffice"
    want = str(SELF)
    try:
        have = os.readlink(link) if link.is_symlink() else ""
        if have == want:
            print(f"命令已就位：{link} → {want}")
            return
        if link.is_symlink() or link.exists():
            backup(link)
            link.unlink()
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(want)
        print(f"命令已链接：{link} → {want}（插件与 CLI 现在同源于 {REPO}）")
    except OSError as e:
        print(f"提示：没能更新 {link}（{e}）。插件已经装好，但要设闹钟还需要 postoffice 可执行："
              f"让 {link} 指回 {want}，或设 POSTOFFICE_CLI={want}。")


def cmd_install_opencode(_a):
    d = opencode_config_dir()
    plug = d / "plugins"
    plug.mkdir(parents=True, exist_ok=True)
    shutil.copy2(REPO / "opencode" / "postoffice.ts", plug / "postoffice.ts")
    print(f"OpenCode 插件已装入 {plug / 'postoffice.ts'}（重启 OpenCode 生效）")
    # 插件离开了 checkout 就找不回同目录的 CLI 了，所以这一步必须和上面的复制一起做。
    link_postoffice_cli()
    # let OpenCode agents read/write the mailbox without a permission prompt each time
    for name in ("opencode.json", "opencode.jsonc"):
        cfgf = d / name
        if cfgf.exists():
            break
    else:
        cfgf = d / "opencode.json"
    try:
        cfg = json.loads(cfgf.read_text(encoding="utf-8")) if cfgf.exists() else {"$schema": "https://opencode.ai/config.json"}
    except ValueError:
        print(f"提示：{cfgf} 含注释，未自动修改。想免去读信时的权限确认，请在 permission.external_directory 里加："
              f'"{HOME}/**": "allow"')
        return
    perm = cfg.setdefault("permission", {})
    ext = perm.get("external_directory")
    if isinstance(ext, str):
        ext = {"*": ext}
    ext = ext or {}
    key = f"{HOME}/**"
    if ext.get(key) != "allow":
        bk = backup(cfgf)
        ext[key] = "allow"
        perm["external_directory"] = ext
        cfgf.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        print(f"已允许 OpenCode 读写 {HOME}（{cfgf}" + (f"，备份 {bk}）" if bk else "）"))


