# ---------- $POSTOFFICE_HOME/.env: private runtime settings ----------
# launchd 起的邮递员/面板不继承终端里的 export，所以用一个极小的 stdlib 读取器补上：
# process env 优先，.env 只填 os.environ 里还没有的 POSTOFFICE_* 键。无 shell 语法、
# 无变量展开、无命令替换；格式不合法的行安全忽略并只报行号（绝不回显该行内容）。
_ENV_KEY_RE = re.compile(r"^POSTOFFICE_[A-Z0-9_]+$")


def load_home_env():
    try:
        text = (HOME / ".env").read_text(encoding="utf-8")
    except OSError:
        return
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            print(f"postoffice：.env 第 {n} 行不是 KEY=value，已忽略", file=sys.stderr)
            continue
        key, value = line.split("=", 1)
        key, value = key.strip(), value.strip()
        if not _ENV_KEY_RE.match(key):
            continue
        if value[:1] in ("'", '"'):
            if len(value) < 2 or value[-1] != value[0]:
                print(f"postoffice：.env 第 {n} 行引号不配对，已忽略", file=sys.stderr)
                continue
            value = value[1:-1]
        if key not in os.environ:
            os.environ[key] = value


load_home_env()

