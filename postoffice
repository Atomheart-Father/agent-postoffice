                                 "skill": cmd_install_skill, "postman": cmd_install_postman}[a.part](a))
    p = sp.add_parser("uninstall", help="卸载部件：claude / postman")
    p.add_argument("part", choices=["claude", "postman"])
    p.set_defaults(fn=lambda a: {"claude": cmd_uninstall_claude, "postman": cmd_uninstall_postman}[a.part](a))
    a = ap.parse_args()
    if not getattr(a, "fn", None):
        ap.print_help()
        return 0
    return a.fn(a) or 0


