def recent_acks(name, limit=3):
    rows = [e for e in read_acks() if e.get("to") == name]
    return [{"time": e.get("time", ""), "by": e.get("by", ""), "note": e.get("note", ""),
             "kind": e.get("kind", ""), "id": e.get("id", "")} for e in reversed(rows)][:limit]


def broadcast_rows(limit=10):
    acks = read_acks()
    rows = []
    bdir = broadcasts_dir()
    if bdir.is_dir():
        for f in sorted(bdir.glob("*.json"), reverse=True):
            rec = read_json(f)
            if not rec:
                continue
            dl = float(rec.get("deadline", 0) or 0)
            acked = sum(1 for e in acks
                        if e.get("id") == rec.get("id") and e.get("kind") == "broadcast")
            rows.append({
                "id": rec.get("id", f.stem), "subject": rec.get("subject", ""), "from": rec.get("from", ""),
                "acked": acked, "total": len(rec.get("to", [])),
                "summarized": rec.get("summarized") is True, "error": rec.get("summarized") == "error",
                "deadline": time.strftime("%m-%d %H:%M", time.localtime(dl)) if dl else "",
            })
            if len(rows) >= limit:
                break
    return rows


def group_rows(routes=None, snap=None):
    """Groups with their online count and the same delivery counts as a mailbox."""
    cfg, _ = load_config()
    routes = boxes(load_routes()) if routes is None else routes
    snap = delivery_snapshot(routes) if snap is None else snap
    out = []
    for name, members in ((cfg or {}).get("groups") or {}).items():
        if not isinstance(members, list):
            continue
        counts = {"waiting": 0, "reminded": 0, "failed": 0}
        for m in members:
            _letters, c = mail_state(m, snap)
            for k in counts:
                counts[k] += c[k]
        out.append({"name": name, "members": members, "total": len(members),
                    "online": sum(1 for m in members if m in routes and online(routes[m])),
                    "counts": counts})
    return out


def alias_rows():
    """Where each logical address resolves right now, plus what is still inside its stability window."""
    cfg, _ = load_config()
    routes = boxes(load_routes())
    st = alias_state()
    out = []
    for name, raw in ((cfg or {}).get("aliases") or {}).items():
        spec, aerr = normalize_alias(raw)
        if spec is None or not isinstance(spec.get("candidates"), list):
            out.append({"name": name, "error": aerr or "candidates 必须是非空数组"})
            continue
        a = st["aliases"].get(name) or {}
        left = 0
        if a.get("pending") and a.get("pending_since"):
            left = max(0, int(ALIAS_STABLE - (time.time() - float(a["pending_since"]))))
        out.append({"name": name, "target": alias_target(spec, routes), "confirmed": a.get("confirmed"),
                    "pending": a.get("pending"), "pending_in": left, "notify": spec.get("notify") or [],
                    "handoff": spec.get("handoff") or "",
                    "candidates": [{"name": c, "known": c in routes,
                                    "online": bool(routes.get(c)) and online(routes.get(c, {}))}
                                   for c in spec["candidates"]]})
    return out


def switch_rows(limit=10):
