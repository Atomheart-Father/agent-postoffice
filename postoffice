def cmd_init(_a=None, quiet=False):
    HOME.mkdir(parents=True, exist_ok=True)
    LOGS.mkdir(exist_ok=True)
    if not ROUTES.exists():
        save_routes({"_说明": "收件人 → 投递方式。用 `postoffice add/online/offline/remove` 修改；各部件每轮都会重读。"})
    guide = REPO / "docs" / "MAILBOX_GUIDE.md"
    if guide.exists():
        readme = HOME / "README.md"
        body = guide.read_text(encoding="utf-8").replace("{HOME}", str(HOME)).replace("{POSTOFFICE}", str(SELF))
        if readme.exists() and "<!-- agent-postoffice:generated -->" not in readme.read_text(encoding="utf-8"):
            readme.replace(HOME / f"README.old-{int(time.time())}.md")
        readme.write_text(body, encoding="utf-8")
    bin_dir = HOME / "bin"
    bin_dir.mkdir(exist_ok=True)
    send = bin_dir / "send.sh"   # 兼容旧用法：bin/send.sh <to> <from> <事由> <需要>
    send.write_text(f'#!/bin/bash\nexec "{SELF}" send "$@"\n')
    send.chmod(0o755)
    if not quiet:
        print(f"邮局目录：{HOME}")


def cmd_add(a):
    cmd_init(quiet=True)
    if not re.fullmatch(r"[A-Za-z0-9_\-]+", a.name):
        sys.exit("信箱名只能用英文字母、数字、下划线、横线")
    routes = load_routes()
    r = dict(routes.get(a.name, {}))
    for k in ("claude_title", "claude_session", "session_id", "thread_id", "codex_cli"):
        r.pop(k, None)
    if a.claude:
        r["methods"] = ["claude_hook"]
        r["claude_title"] = a.claude
        if a.claude_session:
            r["claude_session"] = a.claude_session
    elif a.opencode:
        sid, title, directory = opencode_lookup(a.opencode)
        r["methods"] = ["opencode_plugin"]
        r["session_id"] = sid
        print(f"OpenCode 会话：{title}（{sid}，目录 {directory}）")
    elif a.codex:
        cli = find_codex()
        if not cli:
            print("提示：没找到 codex 命令，先登记；装好 Codex 后重跑本命令即可。")
        r["methods"] = ["codex_queue"]
        r["thread_id"] = a.codex
        if cli:
            r["codex_cli"] = cli
    else:
        r["methods"] = ["notify"]
    if a.who:
        r["who"] = a.who
    r.setdefault("status", "online")
    routes[a.name] = r
    for d in ("inbox", "done"):
        (HOME / a.name / d).mkdir(parents=True, exist_ok=True)
    save_routes(routes)
    write_contact(a.name, r)
    print(f"已登记信箱 {a.name}：{METHODS[r['methods'][0]]}")


def cmd_remove(a):
    routes = load_routes()
    if a.name not in routes:
        sys.exit(f"没有信箱 {a.name}")
    del routes[a.name]
    save_routes(routes)
    print(f"已从通讯录移除 {a.name}（信箱目录保留在 {HOME / a.name}）")


def apply_status(name, status):
    routes = load_routes()
    if name not in boxes(routes) or status not in ("online", "offline"):
        return False
    r = routes[name]
    if status == "online" and r.get("status") != "online":
        r["online_since"] = time.time()   # only a real offline→online transition resets the 20-minute clock
    r["status"] = status
    save_routes(routes)
    write_contact(name, routes[name])
    return True


def ensure_online_baseline(routes):
    """Upgrade compatibility: an already-online mailbox with no `online_since` gets the postman's
    first-run time as its baseline, so old backlog does not all alert at once after an upgrade."""
    changed = False
    for name, r in boxes(routes).items():
        if online(r) and "online_since" not in r:
            r["online_since"] = time.time()
            changed = True
            log("postman.log", f"{name} 补 online_since 基线（升级兼容）")
    if changed:
        save_routes(routes)
    return changed


def set_status(name, status):
    if not apply_status(name, status):
        sys.exit(f"没有信箱 {name}；先 `postoffice list` 看看")
    n = len(pending(name))
    if status == "offline":
        print(f"{name} 已设为离线：新信照收，但不提醒；上线后补送。当前积压 {n} 封。")
    else:
        print(f"{name} 已上线：积压的 {n} 封会在 10 秒内送达（受每 10 分钟 6 次的限流）。")


def clear_backlog(name):
    """Move every letter waiting in <name>/inbox to <name>/archived/<time>/ (kept on disk, never sent)."""
    files = pending(name)
    if not files:
        return None, 0
    dst = HOME / name / "archived" / time.strftime("%Y%m%d-%H%M%S")
    dst.mkdir(parents=True, exist_ok=True)
    for f in files:
        f.replace(dst / f.name)
    log("postman.log", f"清空积压 {name}：{len(files)} 封存档到 {dst}")
    return dst, len(files)


def cmd_clear(a):
    if a.name.startswith("@"):
        clear_group(a.name)
        return 0
    if a.name not in boxes(load_routes()):
        sys.exit(f"没有信箱 {a.name}")
    dst, n = clear_backlog(a.name)
    print(f"{a.name} 没有积压的信" if not n else f"已把 {n} 封积压信存档到 {dst}（不会再送出；需要时手动挪回 inbox/）")


def cmd_config(a):
    """`config import FILE` replaces the whole file atomically (after validating and backing up);
    `config show` only reads. Neither one creates a default config or touches mailbox state."""
    if a.action == "show":
        cfg, err = load_config(validate=False)   # show's job is to print what is wrong, not to bail out
        if err:
            sys.exit(err)
        if cfg is None:
            print(f"还没有 {CONFIG}：分组与逻辑地址未启用（物理信箱照常）。"
                  f"\n用 `postoffice config import FILE` 导入；`postoffice config show` 随时查看。")
            return 0
        full = load_routes()
        routes = boxes(full)
        bad = config_errors(cfg, full)
        print(f"配置：{CONFIG}")
        print(f"  groups {len(cfg.get('groups') or {})} 个，aliases {len(cfg.get('aliases') or {})} 个")
        for name, members in (cfg.get("groups") or {}).items():
            if not isinstance(members, list):
                members = []
            print(f"  @{name}：{sum(1 for m in members if m in routes and online(routes[m]))}/{len(members)} 在线")
            for m in members:
                print(f"    - {_box_mark(m, routes)}")
        st = alias_state()
        for name, raw in (cfg.get("aliases") or {}).items():
            spec, aerr = normalize_alias(raw)
            if spec is None or not isinstance(spec.get("candidates"), list):
                print(f"  @{name}：不可用（{aerr}）")
                continue
            target = alias_target(spec, routes)
            print(f"  @{name} → {target or '（当前没有在线候选）'}")
            for c in spec["candidates"]:
                print(f"    - {_box_mark(c, routes)}")
            print(f"    切换通知：{'、'.join(spec['notify']) or '（无）'}")
            print(f"    交接路径：{spec['handoff'] or '（无，只作元数据，邮局不读这个文件）'}")
            a = st["aliases"].get(name) or {}
            if a.get("confirmed") is None and not a.get("seen"):
                print("    切换记录：还没有基线（邮递员首次看到时登记，不广播）")
            elif a.get("pending"):
                left = max(0, int(ALIAS_STABLE - (time.time() - float(a.get("pending_since") or 0))))
                print(f"    切换记录：已确认 {a.get('confirmed') or '（无）'}；待切换 {a['pending'] or '（无在线候选）'}"
                      f"（稳定期还剩 {left} 秒）")
            else:
                print(f"    切换记录：已确认 {a.get('confirmed') or '（无）'}")
        if bad:
            print("注意：这份配置现在有问题，相关操作会报错：")
            for e in bad:
                print(f"  - {e}")
        return 0

    src = Path(a.file).expanduser()
    try:
        raw = src.read_text(encoding="utf-8")
    except OSError as e:
        sys.exit(f"读不了 {src}：{e}（{CONFIG.name} 保持原样）")
    try:
        cfg = json.loads(raw, object_pairs_hook=_reject_dup_keys)
    except ValueError as e:
        sys.exit(f"{src} 不是合法 JSON：{e}（{CONFIG.name} 保持原样）")
    bad = config_errors(cfg, load_routes())
    if bad:
        sys.exit(f"配置没通过校验（{CONFIG.name} 保持原样）：\n" + "\n".join(f"- {e}" for e in bad))
    bk = None
    if CONFIG.exists():
        LOGS.mkdir(parents=True, exist_ok=True)
        bk = LOGS / f"config.json.{time.strftime('%Y%m%d-%H%M%S')}.bak"
        shutil.copy2(CONFIG, bk)
    tmp = CONFIG.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CONFIG)                       # whole-file replace, never a merge
    print(f"已导入配置：{CONFIG}" + (f"（旧文件备份：{bk}）" if bk else ""))
    print(f"  groups {len(cfg.get('groups') or {})} 个，aliases {len(cfg.get('aliases') or {})} 个")
    return 0


def _box_mark(name, routes):
    r = routes.get(name)
    if r is None:
        return f"{name}：未登记"
    return f"{name}：{'在线' if online(r) else '离线'}"


def cmd_send(a):
    routes = load_routes()
    to, extra = a.to, []
    if a.to.startswith("@"):
        # resolve once, right now: a pending switch never delays or re-routes a new letter
        target, lines, _spec = resolve_alias(require_config("逻辑地址"), a.to[1:], routes)
        print(f"解析 {a.to} → {target}")
        print("\n".join(lines))
        to, extra = target, [f"逻辑地址：{a.to}"]
    if not (HOME / to / "inbox").is_dir():
        sys.exit(f"没有信箱 {to}；`postoffice list` 看通讯录")
    body = Path(a.file).read_text(encoding="utf-8") if a.file else sys.stdin.read()
    path = write_letter(to, a.sender, a.subject, clean_need(a.need), body, extra_headers=extra)
    print(f"已投递：{path}")
    print(f"编号：{path.stem}")
    r = boxes(routes).get(to, {})
    if r and not online(r):
        print(f"注意：{to} 目前离线，信会留在信箱，等它上线再提醒。")


def resolve_ack_target(name, ref):
    """(bid, kind, letter, to, subject) — the broadcast id this ack really means.

    `ref` is either a broadcast id or the physical letter id whose *header* carries `广播：<bid>`;
    both normalise to the same bid, so acking one way and then the other records one receipt.
    A letter that claims a broadcast which does not exist (or is not addressed here) is an error,
    never a silent downgrade to a plain letter ack.
    """
    rec = broadcast_record(ref) if looks_like_bid(ref) else None
    if rec is not None:
        if name not in rec.get("to", []):
            sys.exit(f"{ref} 是广播，但不是发给 {name} 的，不记账")
        return rec["id"], "broadcast", find_broadcast_letter(name, rec["id"]), rec.get("from", ""), \
            rec.get("subject", "")
    letter = find_letter(name, ref)
    if not letter:
        sys.exit(f"找不到编号 {ref} 的信：编号是文件名去掉 .md，或广播编号；也可能不是发给 {name} 的")
    bid = broadcast_letter_id(letter)
    if bid or header_field_present(letter, "广播："):
        # A `广播：` header is a claim about this letter: blank or malformed is an error, never a
        # silent downgrade to a plain letter ack (nothing is written when this exits).
        if not looks_like_bid(bid):
            sys.exit(f"{ref} 的「广播：」信头是空的或不是广播编号格式；不记账，也不改账本或原信")
        rec = broadcast_record(bid)
        if rec is None:
            sys.exit(f"{ref} 标着广播 {bid}，但没有这份广播的记录；不记账（可 `postoffice list` 核对）")
        if name not in rec.get("to", []):
            sys.exit(f"{ref} 属于广播 {bid}，但不是发给 {name} 的，不记账")
        return rec["id"], "broadcast", letter, rec.get("from", ""), rec.get("subject", "")
    return ref, "letter", letter, letter_sender(letter), field(letter, "事由：").replace("事由：", "", 1)


def cmd_ack(a):
    """Record the receipt and notify the sender; receipt notifications never need another ack."""
    routes = load_routes()
    if a.name not in boxes(routes):
        sys.exit(f"没有信箱 {a.name}；`postoffice list` 看通讯录")
    bid, kind, letter, to, subject = resolve_ack_target(a.name, a.id)
    for e in read_acks():                    # dedup on the normalised id, so mixing the two forms counts once
        if e.get("by") == a.name and e.get("id") == bid:
            print(f"已回执过：{bid}（{e.get('time', '')}）")
            if letter:
                to_done(letter)
            return 0
    note = a.note or ""
    if not to:
        sys.exit(f"这封信没有可识别的发信方，无法记账：{a.id}")
    if letter and receipt_query_id(letter):
        to_done(letter)
        print("回执通知已归档，不再产生回执。")
        return 0
    rec = broadcast_record(bid) if kind == "broadcast" else None
    append_ack({"time": now_str(), "by": a.name, "id": bid, "kind": kind, "note": note, "to": to})
    to_done(letter)
    if kind == "broadcast":
        done = sum(1 for e in read_acks() if e.get("id") == bid and e.get("kind") == "broadcast")
        print(f"已回执：{bid}（广播 {done}/{len(rec.get('to', []))}，不会单独叫醒 {to}）")
    else:
        print(f"已回执：{bid}（空闲时通知 {to}，默认不答复）")
    if kind == "letter" or a.wake:
        if to in boxes(routes) and (HOME / to / "inbox").is_dir():
            prefix = "copy that" if a.wake else "回执"
            body = (f"对应原信：{bid}\n"
                    f"回执正文只存在账本，按需查询：postoffice receipt {shlex.quote(to)} {shlex.quote(bid)}")
            path = write_letter(to, a.name, f"{prefix}：{subject}", "回执（默认不答复）", body,
                                extra_headers=[f"回执：{bid}", f"原事由：{subject}"])
            print(f"已投递回执通知：{path}")
        else:
            print(f"注意：发信方 {to} 没有登记信箱；回执仅保留在账本。")
    return 0


def cmd_receipt(a):
    """Read-only exact lookup of receipts recorded for <name> under this id (acks.jsonl is the source)."""
    routes = boxes(load_routes())
    if a.name not in routes:
        sys.exit(f"没有信箱 {a.name}；`postoffice list` 看通讯录")
    rows = [e for e in read_acks() if e.get("id") == a.id and e.get("to") == a.name]
    rec = broadcast_record(a.id)
    if rec is not None and rec.get("from") != a.name:
        sys.exit(f"{a.id} 不是发给 {a.name} 的回执")
    if not rows and rec is None:
        sys.exit(f"找不到回执 {a.id}（编号要精确：文件名去 .md，或广播编号）")
    print(f"回执 {a.id}（{len(rows)} 条）：")
    for e in rows:
        print(f"- 来源：{e.get('by', '')}")
        print(f"  时间：{e.get('time', '')}")
        print(f"  内容：{e.get('note') or '（未写内容）'}")
    if rec is not None:
        acks = broadcast_acks(a.id)
        total = rec.get("to", [])
        dl = float(rec.get("deadline", 0) or 0)
        state = "已汇总" if rec.get("summarized") is True \
            else "汇总失败" if rec.get("summarized") == "error" else "未汇总"
        print(f"广播汇总：已回执 {len(acks)}/{len(total)}，"
              f"截止 {time.strftime('%Y-%m-%d %H:%M', time.localtime(dl)) if dl else '—'}，{state}")
        missing = [n for n in total if n not in acks]
        if missing:
            print("未回执：" + "、".join(f"{n}（离线）" if not online(routes.get(n, {})) else n
                                        for n in missing))
    return 0


def cmd_archive_receipt(a):
    """File this box's receipt notification(s) for exactly <id> into done/.

    Only runs when the caller passes the ID; it never auto-archives. Matches the `回执：<id>`
    header block only (never body text). It never reads the receipt body, never touches the ledger,
    and never sends or wakes anyone. It first prints how many notifications matched — one id can
    cover several — then checks every match: if ANY would overwrite an existing done/ file,
    nothing is moved and the command exits non-zero (both source and target are kept)."""
    routes = boxes(load_routes())
    if a.name not in routes:
        sys.exit(f"没有信箱 {a.name}；`postoffice list` 看通讯录")
    inbox = HOME / a.name / "inbox"
    done = HOME / a.name / "done"
    matches = sorted(p for p in inbox.glob("*.md") if receipt_query_id(p) == a.id) if inbox.is_dir() else []
    print(f"匹配 {len(matches)} 封回执通知（{a.id}）")   # count first, so a wrong id is obvious before anything moves
    if not matches:
        print("没有待归档的回执通知")
        return 0
    clashes = [p.name for p in matches if (done / p.name).exists()]
    if clashes:
        sys.exit(f"done/ 已有同名文件，未归档任何通知（{a.id}）：{'、'.join(clashes)}")
    done.mkdir(parents=True, exist_ok=True)
    for p in matches:
        p.replace(done / p.name)
    print(f"已归档 {len(matches)} 封回执通知（{a.id}）")
    return 0


def retract_refused_reason(name, path, method, skip_claim=False):
    """Why this letter can no longer be pulled back, or "" when the channel has not taken it yet.

    Each channel is judged by its own record, never by another channel's idea of "delivered": the
    shared claim file the OpenCode plugin, the hook and the postman all take before waking somebody,
    plus that channel's own ledger. An unknown channel has no record we can trust, so it fails closed.
    """
    if claimed(name, path) and not skip_claim:
        return "投递进行中（已有投递认领）"
    if method == "opencode_plugin":
        ledger = HOME / "opencode_delivered.jsonl"
        if ledger.exists():
            for line in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("box") == name and e.get("file") == path.name:
                    if e.get("result") == "DELIVERED":
                        return "已送达（插件台账 DELIVERED）"
                    if e.get("result") == "FAILED_FINAL":
                        # 失败不等于送达，也不等于没送达：不确定就不撤
                        return "投递失败/无法确认对方是否收到（插件台账 FAILED_FINAL）"
        return ""
    if method == "claude_hook":
        if str(path) in read_lines(HOME / name / ".seen"):
            return "已送达（Claude 钩子 .seen 已记录）"
        return ""
    if method in ("codex_queue", "notify"):
        woken = read_json(HOME / ".woken.json")
        if isinstance(woken, dict) and str(path) in woken:
            return f"已送达（邮递员接受记录 {method}）"
        return ""
    return f"无法核实该通道（{method}）是否已接受，fail closed 不撤回"


def cmd_retract(a):
    """Pull back one ordinary letter that its recipient's channel has not accepted yet.

    First release only: `ack` receipts, broadcast copies, handover notes and alarm letters are all
    derived notices and are refused here -- they belong to whoever asked for them, not to the sender
    of the letter they point at. The ID is exact (no path, no glob, no prefix), the letter's 来源 must
    be the box the caller named, and it has to sit in that box's inbox/ right now. Anything the
    recipient's channel may already have handed over is refused instead of moved, so a retraction can
    never race a wake-up into "retracted but still delivered". Nothing is written, no notice goes out,
    the body is untouched, and no correction is sent for you.
    """
    routes = boxes(load_routes())
    if a.to not in routes:
        sys.exit(f"没有信箱 {a.to}（收件方）；`postoffice list` 看通讯录")
    if not a.id or any(c in a.id for c in "/\\*?[]") or a.id.startswith("."):
        sys.exit(f"撤回只接受完整信件编号，不接受路径、通配符或前缀：{a.id!r}")
    if a.id.endswith(".md"):
        sys.exit(f"信件编号是文件名去掉 .md，不要带后缀：{a.id!r}")
    inbox = HOME / a.to / "inbox"
    path = inbox / f"{a.id}.md"
    if not inbox.is_dir() or not path.is_file():
        sys.exit(f"{a.to} 的 inbox/ 里没有编号为 {a.id} 的信；撤回只处理仍在收件方 inbox/ 的信"
                 f"（已送达、已归档或在别处的都不归它管）")
    derived = [k for k in ("回执：", "广播：", "闹钟：", "切换事件：") if header_field_present(path, k)]
    if derived or letter_sender(path) == "postoffice":
        sys.exit(f"{a.id} 不是普通直发信（信头含 {'、'.join(derived) or '系统来信'}），撤回只用于普通 send 的信")
    if a.sender not in routes:
        sys.exit(f"没有信箱 {a.sender}（发信方）；`postoffice list` 看通讯录")
    sender = letter_sender(path)
    if sender != a.sender:
        sys.exit(f"信 {a.id} 的来源是 {sender or '（读不出来）'}，不是你指定的 {a.sender}；不撤回别人的信")
    method = routes[a.to].get("methods", ["notify"])[0]
    why = retract_refused_reason(a.to, path, method)
    if why:
        sys.exit(f"{a.id} {why}，无法撤回；原信留在 {path}。"
                 f"要更正就另发一封修正信，不要假装这封没发过")
    # 和投递方原子地争同一把认领：认领是 O_EXCL 的，所以要么我们赢、要么投递方赢，
    # 不存在「我们查完还没动，投递方就来认领并唤醒」的中间态。
    if not claim_letter(a.to, path):
        sys.exit(f"{a.id} 投递进行中（认领已被投递方抢到），无法撤回；原信留在 {path}。"
                 f"要更正就另发一封修正信，不要假装这封没发过")
    try:
        # 认领已经握在手里，所以这一次只看台账（skip_claim）：不然会把自己刚拿的认领当成别人
        why = retract_refused_reason(a.to, path, method, skip_claim=True)
        if why:
            sys.exit(f"{a.id} {why}，无法撤回；原信留在 {path}。")
        dst_dir = HOME / a.to / "archived" / time.strftime("%Y%m%d-%H%M%S")
        dst = dst_dir / path.name
        if dst.exists():
            sys.exit(f"归档里已有同名文件，未撤回（{dst}）；请人工处理")
        dst_dir.mkdir(parents=True, exist_ok=True)
        path.replace(dst)
    finally:
        release_claim(a.to, path)   # 原信已经不在 inbox/，投递方下一轮不会再看见它
    log("postman.log", f"撤回 {a.sender} → {a.to} {a.id}：通道 {method} 未接受，原信存档到 {dst}")
    print(f"已撤回 {a.id}")
    print(f"原信原样存档到 {dst}（正文未改，没有写任何通知，也没有替你补发修正）")
    print(f"核实依据：{a.to} 走 {method} 通道，投递认领为空、该通道的送达记录里没有这封信")
    print("收件方没有被提醒过。如果对方已从别的途径得知内容，要不要另发修正由你决定")
    return 0


def post_broadcast(sender, to, subject, need, body, secs, bid=None, only=None, done_set=None):
    """Create the broadcast record and drop one letter per recipient. Returns (bid, [(name, path)]).

    Recipients are validated by the caller; this is the single place a broadcast is created, so a
    system-initiated switch reuses exactly the same delivery and tallying path as `broadcast`.

    `bid` pins the id (a switch event derives one from its own event id, so a resumed step can
    never mint a second record); an id already on disk is reused rather than suffixed.
    `only` limits delivery to the recipients that still need a letter and `done_set` collects them
    as each letter lands, so a partial failure resumes per recipient instead of re-posting.
    """
    bdir = broadcasts_dir()
    bdir.mkdir(parents=True, exist_ok=True)
    if not bid:
        ts = time.strftime("%Y%m%d-%H%M%S")
        bid, i = f"B{ts}_{sender}", 2
        while (bdir / f"{bid}.json").exists():
            bid = f"B{ts}_{sender}-{i}"
            i += 1
    rec = read_json(bdir / f"{bid}.json")
    if not isinstance(rec, dict) or rec.get("id") != bid:
        rec = {"id": bid, "from": sender, "subject": subject, "need": clean_need(need), "to": list(to),
               "deadline": time.time() + secs, "created": now_str(), "acks": {}, "summarized": False}
        (bdir / f"{bid}.json").write_text(json.dumps(rec, ensure_ascii=False, indent=2) + "\n",
                                          encoding="utf-8")
    out = []
    for n in to:
        if only is not None and n not in only:
            continue
        text = f"{body.rstrip()}\n\n回执请用：postoffice ack {n} {bid} \"一句话\""
        out.append((n, write_letter(n, sender, subject, clean_need(need), text,
                                     extra_headers=[f"广播：{bid}"])))
        if done_set is not None:
            # Recorded after the letter really landed, so a caller that dies mid-batch still knows
            # exactly who got it and never re-posts to them.
            done_set.add(n)
    return bid, out


def cmd_broadcast(a):
    """One letter per recipient tagged with a broadcast id; acks are tallied into one summary letter later."""
    routes = boxes(load_routes())
    if a.sender not in routes or not (HOME / a.sender / "inbox").is_dir():
        sys.exit(f"发信方 {a.sender} 不是已登记的信箱（要有 inbox）；先 `postoffice add`")
    if a.to.strip() == "all":
        to = [n for n in routes if n != a.sender]
    else:
        to = [x.strip() for x in a.to.split(",") if x.strip()]
    to = list(dict.fromkeys(to))
    if not to:
        sys.exit("没有收件人")
    for n in to:
        if n not in routes or not (HOME / n / "inbox").is_dir():
            sys.exit(f"没有信箱 {n}；`postoffice list` 看通讯录")
    body = Path(a.file).read_text(encoding="utf-8") if a.file else sys.stdin.read()
    secs = parse_duration(a.deadline or os.environ.get("POSTOFFICE_BROADCAST_DEADLINE", "30m"))
    bid, sent = post_broadcast(a.sender, to, a.subject, a.need, body, secs)
    print(f"广播编号：{bid}")
    print(f"截止：{time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(time.time() + secs))}")
    for n, path in sent:
        print(f"已投递：{path}")
        r = routes.get(n, {})
        if r and not online(r):
            print(f"注意：{n} 目前离线，信会留在信箱，等它上线再提醒。")
    return 0


def broadcast_acks(bid):
    """Receipts for one broadcast, from acks.jsonl (the append-only source of truth): {by: note}."""
    return {e.get("by"): e.get("note", "")
            for e in read_acks() if e.get("id") == bid and e.get("kind") == "broadcast"}


def broadcast_record(bid):
    """Find a broadcast record by exact id. Scans, so a receipt id is never treated as a path."""
    bdir = broadcasts_dir()
    if not bdir.is_dir():
        return None
    for f in bdir.glob("*.json"):
        rec = read_json(f)
        if rec and rec.get("id") == bid:
            return rec
    return None


ALARM_TEXT = "你设的闹钟到了，请检查刚才安排的任务。"   # the one and only alarm reminder text
ALARM_LOCK_WAIT = float(os.environ.get("POSTOFFICE_ALARM_LOCK_WAIT", 5))    # 秒；拿不到锁时的退避上限
ALARM_MIN = 1                # 分钟
ALARM_MAX = 1440             # 一天


def alarms_dir():
    """Runtime ledger for session self-set alarms — not a user-maintained config, never imported."""
    return HOME / "alarms"


def alarm_file(session):
    """One file per session: set/cancel/fire each touch only their own record, so the plugin tool
    and the postman never overwrite each other's entries."""
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", session)[:80]
    if not safe or safe != session:
        safe = hashlib.sha256(session.encode("utf-8")).hexdigest()[:32]
    return alarms_dir() / f"{safe}.json"


def read_alarm(session):
    return read_json(alarm_file(session))


def write_alarm(rec, path=None):
    p = path or alarm_file(rec.get("session") or "")
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(rec, ensure_ascii=False) + "\n", encoding="utf-8")
    try:
        os.chmod(tmp, 0o600)      # runtime ledger: owner only
    except OSError:
        pass
    tmp.replace(p)


def list_alarms():
    """Every alarm record on disk as (path, record); skips malformed files instead of failing."""
    out = []
    d = alarms_dir()
    if not d.is_dir():
        return out
    for p in sorted(d.glob("*.json")):
        rec = read_json(p)
        if isinstance(rec, dict) and rec.get("id") and rec.get("box") and rec.get("session"):
            out.append((p, rec))
    return out


# 同一会话的闹钟记录同时被插件工具（转给 alarm-set / alarm-cancel）和本邮递员（到期）改，
# 跨进程没有共享内存，所以每个会话一把内核 flock 锁：抢不到就说明有人在改，这一轮跳过。
# 崩溃恢复由内核负责（持有者死了/被 kill/重启，内核放锁），锁文件只建不删不替换 ——
# 所以不需要看门狗，也不会出现「回收者删掉新锁」或「旧持有者删掉新锁」。
def alarm_lock_path(path):
    return path.with_suffix(".json.lock")


def take_alarm_lock(path):
    """Take the per-session kernel lock without blocking; returns the held fd or None.

    flock(2) is the whole primitive, and that is the point: the kernel drops it when the holder
    dies, is killed or the machine reboots, so there is no mtime watchdog, no pid probe, no reaper
    lock and no stat-identity dance to get wrong. The lock file is created once and never unlinked
    or replaced, which removes the ABA case outright: a holder that comes back after a long pause
    unlocks its own descriptor and can never remove a successor's lock -- there is no unlink on
    this path at all.
    """
    p = alarm_lock_path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(p), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def release_alarm_lock(fd):
    """Unlock and close. Only touches our own descriptor, so nothing else can be affected."""
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    finally:
        os.close(fd)


def with_alarm_lock(session):
    """Context manager: the kernel lock for one session, retried briefly then given up on.

    Whoever holds it may be mid-write or may have been killed outright -- in the second case the
    kernel has already released it, so a bounded retry is all the waiting there ever is.
    """
    import contextlib
    import time as _time

    @contextlib.contextmanager
    def cm():
        path = alarm_file(session)
        deadline = _time.time() + ALARM_LOCK_WAIT
        fd = None
        while fd is None:
            fd = take_alarm_lock(path)
            if fd is not None:
                break
            if _time.time() >= deadline:
                yield None
                return
            _time.sleep(0.05)
        try:
            yield fd
        finally:
            release_alarm_lock(fd)

    return cm()


def archive_alarm_letter(box, aid):
    """File an undelivered alarm letter out of the way. Returns where it went, or None."""
    src = HOME / box / "inbox" / f"{aid}.md"
    if not src.exists():
        return None
    dst_dir = HOME / box / "archived" / time.strftime("%Y%m%d-%H%M%S")
    dst_dir.mkdir(parents=True, exist_ok=True)
    src.replace(dst_dir / src.name)
    return dst_dir / src.name


def cmd_alarm_set(a):
    """Set one alarm for one session. The caller is the plugin, which has already resolved which
    mailbox this session owns; the box and session are re-checked against the registry here so a
    stale mapping cannot write a record."""
    box, sid, delay = a.box, a.session, int(a.delay)
    if delay < ALARM_MIN or delay > ALARM_MAX:
        sys.exit(f"延迟要在 {ALARM_MIN}–{ALARM_MAX} 分钟之间，收到 {delay}")
    rec = {"box": box, "session": sid}
    with with_alarm_lock(sid) as fd:
        if fd is None:
            sys.exit("另一个进程正在改这个会话的闹钟，这次没有落下任何记录")
        # 路由核验必须在锁内：锁外读到的那份 routes 可能在我们等锁这段时间里被改绑或解绑，
        # 那样就会拿一份过期映射去落记录 —— 而真正要写的就是这条记录。
        ok, why = verify_alarm_identity(load_routes(), rec)
        if not ok:
            sys.exit(why)
        cur = read_alarm(sid)
        if isinstance(cur, dict) and cur.get("state") in ("pending", "lettered"):
            due = time.strftime("%Y-%m-%d %H:%M", time.localtime(float(cur.get("due") or 0)))
            sys.exit(f"这个会话已经有一个活动闹钟（{cur.get('id')}，{due} 到期）。"
                     f"要改时间先 postoffice_alarm_cancel() 取消，再重新设。")
        stamp = time.strftime("%Y%m%d-%H%M%S")
        new = {"id": f"A{stamp}_{re.sub(r'[^A-Za-z0-9_.-]', '_', box)[:24]}",
               "box": box, "session": sid, "due": time.time() + delay * 60,
               "created": time.time(), "state": "pending"}
        write_alarm(new)
    log("postman.log", f"闹钟 {new['id']}：{box} {sid} 将在 {delay} 分钟后提醒")
    print(f"已设闹钟：{new['id']}")
    print(f"到期时间：{time.strftime('%Y-%m-%d %H:%M', time.localtime(new['due']))}"
          f"（{delay} 分钟后，按本机时间）")
    print(f"绑定：只唤醒 {box} 这个信箱里当前绑定的那个会话；换绑或下线都会让它保留不丢")
    print(f"现在结束本轮：不要 sleep、不要轮询、不要空转。到期时邮局只投一句固定短提醒"
          f"「{ALARM_TEXT}」")
    return 0


def cmd_alarm_cancel(a):
    """Cancel this session's alarm. Only ever touches the record bound to this session and box."""
    box, sid = a.box, a.session
    rec = read_alarm(sid)
    if not isinstance(rec, dict) or not rec.get("id"):
        print("本会话当前没有活动闹钟，无需取消。")
        return 0
    if rec.get("session") != sid or rec.get("box") != box:
        sys.exit(f"这条闹钟属于 {rec.get('box')}，不是 {box}；没有动它")
    with with_alarm_lock(sid) as fd:
        if fd is None:
            sys.exit("另一个进程正在改这个会话的闹钟，这次没有改动")
        # 路由核验同样在锁内做：等锁期间信箱可能被下线、换通道或改绑给别人，
        # 锁外读到的那份 routes 不能当作依据。
        #
        # 身份核验无条件执行，**离线不构成豁免**：信箱离线只是「现在没人收」，而
        # 「这个信箱是不是还归这个会话」是另一回事。旧实现在这里跳过整段核验，于是
        # routes 标着 offline、但 methods 已被移除或 session_id 已改绑给别人时，
        # CLI 仍会按调用方给的 box/session 去清记录、归档提醒——那正好是越权路径。
        # offline 只影响下面「要不要动 inbox」这一步，不影响能不能操作这条记录。
        routes = load_routes()
        offline = bool(routes.get(box, {}).get("status") == "offline")
        ok, why = verify_alarm_identity(routes, rec)
        if not ok:
            sys.exit(why)
        cur = read_alarm(sid)
        if not isinstance(cur, dict) or not cur.get("id"):
            print("这个闹钟刚刚已经被取消。")
            return 0
        if cur.get("session") != sid or cur.get("box") != box:
            sys.exit(f"这条闹钟属于 {cur.get('box')}，不是 {box}；没有动它")
        aid = cur["id"]
        where = ""
        if cur.get("state") == "lettered" and cur.get("letter") == aid and alarm_gave_up(box, aid):
            where = ("投递失败、无法确认收件方是否收到，因此不能算送达；"
                     "只清掉运行态记录，那封信仍在信箱里")
        elif cur.get("state") == "lettered" and cur.get("letter") == aid and alarm_delivered(box, aid):
            where = "已经送达过了"
        elif offline:
            # 信箱当下离线：身份是唯一的，但没人收，所以只清定时器，不碰 inbox 里的提醒
            where = "信箱当前离线，没有待送达的提醒需要撤回；只清掉这个会话的定时器。"
        else:
            moved = archive_alarm_letter(box, aid)
            if moved:
                where = f"提醒已投递但还没送达，原信存档到 {moved}，不会再响"
            else:
                where = "定时器已清掉，信箱里没有待响的提醒"
        try:
            alarm_file(sid).unlink()
        except FileNotFoundError:
            pass
    log("postman.log", f"闹钟 {aid} 已取消（{box} {sid}）：{where}")
    print(f"已取消闹钟 {aid}：{where}")
    print("只清掉了这个会话的运行态记录，没有碰别的信箱，也没有改任何信件正文。")
    return 0


def opencode_session_exists(sid):
    """True / False / None — None means there is no database to check against, which is not the
    same as the session not existing."""
    db = opencode_db()
    if not db.exists():
        return None
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        try:
            return con.execute("select 1 from session where id=? limit 1", (sid,)).fetchone() is not None
        finally:
            con.close()
    except Exception:
        return None


def verify_alarm_identity(routes, rec):
    """Re-check a recorded alarm against the registry before writing anything. The record is only
    a claim: a box that is gone, stopped using the plugin channel, got rebound to another session,
    or a session OpenCode has never heard of, is refused instead of guessed."""
    box, sid = rec.get("box"), rec.get("session")
    r = routes.get(box) if isinstance(routes, dict) else None
    if not r or not isinstance(r, dict):
        return False, f"信箱 {box} 未登记"
    if "opencode_plugin" not in (r.get("methods") or []):
        return False, f"信箱 {box} 不再由 OpenCode 插件投递"
    if r.get("session_id") != sid:
        return False, f"信箱 {box} 现在绑的是别的会话"
    if opencode_session_exists(sid) is False:
        return False, f"OpenCode 里找不到会话 {sid}"
    return True, ""


def alarm_delivered(box, lid):
    """Has this alarm's letter been *accepted* by a session? The ledger is the same source of truth
    the plugin and the panel use.

    DELIVERED only. FAILED_FINAL means the plugin gave up and whether the recipient ever saw the
    letter is unknown, so it must never read as delivered -- same rule the retraction path follows.
    """
    ledger = HOME / "opencode_delivered.jsonl"
    if not ledger.exists():
        return False
    try:
        for line in ledger.read_text(encoding="utf-8").splitlines():
            if not line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if (e.get("box") == box and e.get("file") == f"{lid}.md"
                    and e.get("result") == "DELIVERED"):
                return True
    except OSError:
        return False
    return False


def alarm_gave_up(box, lid):
    """Did the plugin give up on this letter? Unknown outcome, so the honest wording is
    "delivery failed, cannot confirm", never "already delivered"."""
    ledger = HOME / "opencode_delivered.jsonl"
    if not ledger.exists():
        return False
    try:
        for line in ledger.read_text(encoding="utf-8").splitlines():
            if not line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if (e.get("box") == box and e.get("file") == f"{lid}.md"
                    and e.get("result") == "FAILED_FINAL"):
                return True
    except OSError:
        pass
    return False


def process_alarms(routes):
    """Turn each due alarm into exactly one fixed-sentence letter in that same physical mailbox.

    Runs in the resident postman loop, so no timer lives in the plugin. The letter's file name is
    the alarm id, which makes the "letter written but state not saved" crash window a no-op instead
    of a second reminder. Delivery, offline deferral and de-duplication are the existing plugin
    channel's job; we only queue.
    """
    now = time.time()
    for path, _seen in list_alarms():
        # 每个会话一把锁：抢不到说明插件工具正在改同一条记录，这一轮跳过（不排队、不覆盖）。
        # 拿到锁之后必须重读，因为刚才那次读可能和写者撞在一起。
        fd = take_alarm_lock(path)
        if fd is None:
            log("postman.log", f"闹钟记录 {path.stem} 正被另一个进程改动，这一轮跳过")
            continue
        try:
            rec = read_json(path)
            if isinstance(rec, dict) and rec.get("id"):
                handle_alarm(routes, path, rec, now)
        finally:
            release_alarm_lock(fd)


def handle_alarm(routes, path, rec, now):
    """One alarm record, already re-read under this session's lock."""
    box, session, aid = rec.get("box"), rec.get("session"), rec.get("id")
    state = rec.get("state")
    if state == "lettered":
        # lettered 记录必须指着它自己那封信：缺 letter 或指错了都当作记录不完整，
        # 不拿它去判定送达——和插件侧的 alarmLetterOwns 同一个口径。
        if rec.get("letter") != aid:
            return
        delivered = alarm_delivered(box, rec["letter"])
        gave_up = not delivered and alarm_gave_up(box, rec["letter"])
        if delivered or gave_up:
            try:
                path.unlink()
            except FileNotFoundError:
                pass
            # 两种情况都意味着这次闹钟不会再响，但只有一种能说「送达了」：
            # 插件放弃投递时收件方到底看没看到是未知的，如实这么写。
            log("postman.log",
                f"闹钟 {aid} 已送达，清掉活跃记录 {session}" if delivered else
                f"闹钟 {aid} 投递失败到上限、收件方是否收到未知，不再重试，清掉活跃记录 {session}")
        return
    if state == "refused":
        return
    try:
        due = float(rec.get("due") or 0)
    except (TypeError, ValueError):
        due = 0.0
    if due > now:
        return
    ok, why = verify_alarm_identity(routes, rec)
    if not ok:
        rec["state"] = "refused"
        rec["refused_reason"] = why
        write_alarm(rec, path)
        log("postman.log", f"闹钟 {aid} 拒绝投递：{why}")
        notify_once(f"alarm-refused-{aid}", "联络总站：闹钟身份核不上",
                    f"{session} 的闹钟 {aid} 没有投递：{why}")
        return

    landed = letter_tagged(box, "闹钟：", aid)
    if landed is not None:
        # 状态没落盘的那段窗口：信可能还在 inbox，也可能已经被收信方挪走或归档。
        # 三处都算送达证据，否则取消过的闹钟会因为「inbox 里找不到了」再响一次。
        log("postman.log", f"闹钟 {aid} 的提醒信已在 {landed.parent.name}（上次写成功但状态没落盘），不重复写")
    else:
        try:
            write_letter(box, "postoffice", "闹钟", "仅告知", ALARM_TEXT,
                         extra_headers=[f"闹钟：{aid}"], name=aid)
        except Exception as e:
            log("postman.log", f"闹钟 {aid} 写提醒信失败：{e}")
            return
        log("postman.log", f"闹钟 {aid} 到期，已排入 {box} 的 inbox（等插件投递）")
    rec["state"] = "lettered"
    rec["letter"] = aid
    rec["lettered_at"] = now
    write_alarm(rec, path)


def summarize_broadcasts(routes):
    """One summary letter to the sender: everyone acked, or the deadline has passed. Never twice."""
    bdir = broadcasts_dir()
    if not bdir.is_dir():
        return
    for f in sorted(bdir.glob("*.json")):
        rec = None
        try:
            rec = read_json(f)
            if not rec or rec.get("summarized") or not rec.get("to"):
                continue
            if not (HOME / rec.get("from", "") / "inbox").is_dir():
                # a system-initiated broadcast has no mailbox to summarise back to; record it once, never retry
                rec["summarized"] = True
                tmp = f.with_suffix(".json.tmp")
                tmp.write_text(json.dumps(rec, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
                tmp.replace(f)
                log("postman.log", f"广播 {rec.get('id')} 由系统发出、无收件信箱，跳过汇总")
                continue
            acks = broadcast_acks(rec.get("id"))
            if time.time() < float(rec.get("deadline", 0)) and not all(n in acks for n in rec["to"]):
                continue
            dl = float(rec.get("deadline", 0) or 0)
            missing = [n for n in rec["to"] if n not in acks]
            lines = [f"广播编号：{rec.get('id')}（发信方 {rec.get('from')}）",
                     f"事由：{rec.get('subject', '')}",
                     f"已回执 {len(acks)}/{len(rec['to'])}，"
                     f"截止 {time.strftime('%Y-%m-%d %H:%M', time.localtime(dl)) if dl else '—'}"]
            if missing:
                lines.append("未回执：" + "、".join(
                    f"{n}（离线）" if (routes.get(n) and not online(routes[n])) else n for n in missing))
            lines.append("各人回执正文不随通知投递，按需查询：postoffice receipt "
                         f"{shlex.quote(rec.get('from', ''))} {shlex.quote(rec.get('id', ''))}")
            path = write_letter(rec.get("from", ""), "postoffice", f"广播汇总：{rec.get('subject', '')}",
                                "回执（默认不答复）", "\n".join(lines),
                                extra_headers=[f"回执：{rec.get('id')}", f"原事由：{rec.get('subject', '')}"])
            rec["summarized"] = True
            tmp = f.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(rec, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
            tmp.replace(f)
            log("postman.log", f"广播汇总 {rec.get('id')} → {rec.get('from')}：{path.name}")
        except Exception as e:
            # a broken record must never take the postman down (or retry forever): log, tell the human once, mark done
            log("postman.log", f"广播汇总失败 {f.name}：{e}")
            notify("联络总站：广播汇总失败", f"{f.stem}：{e}")
            try:
                bad = read_json(f) or {}
                bad["summarized"] = "error"
                tmp = f.with_suffix(".json.tmp")
                tmp.write_text(json.dumps(bad, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
                tmp.replace(f)
            except Exception as e2:
                log("postman.log", f"广播 {f.name} 标记 error 也失败：{e2}")


def alias_state():
    st = read_json(ALIAS_STATE)
    if not isinstance(st, dict) or not isinstance(st.get("aliases"), dict):
        st = {"version": 1, "aliases": {}}
    # One counter for the whole state file, not per alias: event ids (and therefore broadcast ids)
    # must stay unique across aliases confirmed in the same second, and must not restart from 1 when
    # an alias is removed and added back — the counter only ever goes up.
    if not isinstance(st.get("seq"), int) or st["seq"] < 0:
        st["seq"] = 0
    return st


def save_alias_state(st):
    tmp = ALIAS_STATE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(st, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(ALIAS_STATE)


def notify_once(key, title, text, store=".notify_once.json"):
    """Tell the human about a recurring condition at most once per key (keeps its own small ledger)."""
    f = HOME / store
    seen = read_json(f)
    seen = set(seen) if isinstance(seen, list) else set()
    if key in seen:
        return False
    notify(title, text)
    seen.add(key)
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(sorted(seen), ensure_ascii=False) + "\n", encoding="utf-8")
    return True


def switch_reason(old, new, spec):
    """Why the target moved, read off the actual change (never a canned 'went offline')."""
    cands = spec["candidates"]
    if new is None:
        return "候选全离线"
    if old is None:
        return "候选上线"
    if old not in cands or new not in cands:
        return "配置调整"
    if cands.index(new) < cands.index(old):
        return "高优先级候选恢复"
    if cands.index(new) > cands.index(old):
        return "原目标下线"
    return "配置调整"


def process_alias_switches(routes):
    """One postman round: confirm a target that has held steady for ALIAS_STABLE seconds, then
    announce the switch exactly once.

    The actual target is recomputed from config+routes every round; ALIAS_STATE only remembers what
    was already announced, so a restart never re-announces and a same-round A→B→A cancels silently.
    Each confirmed switch gets a recoverable event id whose broadcast/handover/human-notify steps are
    de-duplicated separately, so a half-finished event resumes instead of re-broadcasting. The
    broadcast id is derived from the state file's own monotonic counter (not the clock), so two
    aliases confirmed in the same second never collide and re-adding a deleted alias cannot repeat
    an old id. Both the broadcast and the handover note carry that identity in their header, and the
    box itself is the second source of truth, so one event is always exactly one record, one
    broadcast letter and one handover note per recipient — even across a hard interrupt between the
    delivery and the state write.
    """
    cfg, err = load_config()
    if cfg is None:
        if err:
            notify_once(f"cfg::{err}", "联络总站：配置不可用", err)
        return
    st = alias_state()
    dirty = False
    for name in list(st["aliases"]):
        # An alias dropped from config loses its whole history *and that is persisted*: otherwise a
        # restart would read the stale pending state back and resume a switch nobody asked for, or
        # re-adding the alias would inherit an old baseline instead of making a new one.
        if name not in (cfg.get("aliases") or {}):
            del st["aliases"][name]
            dirty = True
            log("postman.log", f"alias @{name} 已从配置移除，清掉它的切换基线与待确认")
    for name, raw in (cfg.get("aliases") or {}).items():
        spec, aerr = normalize_alias(raw)
        if spec is None or not isinstance(spec.get("candidates"), list) or not spec["candidates"]:
            notify_once(f"alias::{name}", "联络总站：配置里的逻辑地址不可用",
                        f"@{name}：{aerr or 'candidates 必须是非空数组'}；该 alias 不参与切换广播")
            continue
        a = st["aliases"].setdefault(name, {"seen": False, "confirmed": None, "pending": None,
                                            "pending_since": 0.0, "events": {}})
        target = alias_target(spec, routes)
        if not a.get("seen"):
            # First sighting is a baseline, not a switch: it never announces the current target.
            # A baseline with nobody online is remembered as "not announced yet" so the spec's
            # once-only "no one can take it" notice still happens after the stability window.
            a.update(seen=True, confirmed=target, pending=None, pending_since=0.0,
                     idle_announced=target is not None)
            dirty = True
            log("postman.log", f"alias @{name} 登记初始目标 {target or '（无在线候选）'}（不广播）")
            continue
        confirmed = a.get("confirmed")
        # `pending` is None both when nothing is pending and when the pending switch is "nobody can
        # take it" — so the in-flight marker is `pending_since`, not `pending`.
        armed = float(a.get("pending_since") or 0) > 0
        idle_notice = confirmed is None and not a.get("idle_announced")
        if target == confirmed and not idle_notice:
            if armed:
                a["pending"], a["pending_since"] = None, 0.0
                dirty = True
                log("postman.log", f"alias @{name} 稳定期内回到 {confirmed or '（无在线候选）'}，撤销待切换")
            continue
        if not armed or a.get("pending") != target:
            a["pending"], a["pending_since"] = target, time.time()
            dirty = True
            log("postman.log", f"alias @{name} 待切换 → {target or '（无在线候选）'}"
                               f"（稳定 {ALIAS_STABLE} 秒后确认）")
            continue
        if time.time() - float(a.get("pending_since") or 0) < ALIAS_STABLE:
            continue
        reason = switch_reason(confirmed, target, spec)
        ev = next((e for e in a["events"].values()
                   if e.get("from") == confirmed and e.get("to") == target and not e.get("done")), None)
        if ev is None:
            # The id is built from the state file's own monotonic counter, not from the clock: two
            # aliases confirmed in the same second would otherwise mint the same broadcast id and one
            # event would inherit the other's record. `at` only decorates it for humans.
            st["seq"] = int(st.get("seq") or 0) + 1
            seq = st["seq"]
            eid = f"E{seq}_{name}_{confirmed or 'none'}___{target or 'none'}"
            ev = {"id": eid, "seq": seq, "at": time.strftime("%Y%m%d-%H%M%S"),
                  "from": confirmed, "to": target,
                  "broadcast": None, "sent": [], "handoff": None, "notified": False, "done": False}
            a["events"][eid] = ev
            save_alias_state(st)                     # persist the id *before* any side effect
        ev.setdefault("sent", [])
        ev.setdefault("seq", st.get("seq", 1))
        ev.setdefault("at", time.strftime("%Y%m%d-%H%M%S"))
        notify_boxes = [x for x in (spec.get("notify") or []) if x in routes]
        steps_ok = True
        if ev["broadcast"] != "-" and len(ev["sent"]) < len(notify_boxes):
            # Step 1: one real broadcast with a deterministic id, delivered per recipient. A retry
            # reuses that id (no second record) and only reaches the boxes with no letter yet —
            # checked against the boxes themselves, so even a crash between the delivery and the
            # state write cannot re-announce.
            bid = ev["broadcast"] or f"B{ev['at']}_sw{ev['seq']}_{name}"
            pending_boxes = [x for x in notify_boxes if x not in ev["sent"] and not broadcast_delivered(x, bid)]
            if not notify_boxes:
                ev["broadcast"] = "-"                # nothing to announce; do not retry every round
                save_alias_state(st)
            elif not pending_boxes:                  # every box already holds this broadcast
                ev["broadcast"] = bid
                save_alias_state(st)
            else:
                landed = set()
                try:
                    bid, sent = post_broadcast(
                        "postoffice", notify_boxes, f"逻辑地址 @{name} 改由 {target or '（无在线候选）'} 受理",
                        "仅告知",
                        f"逻辑地址 @{name} 的受理信箱有变化。\n"
                        f"之前：{confirmed or '（无在线候选）'}\n"
                        f"现在：{target or '（无在线候选）'}\n"
                        f"原因：{reason}\n\n"
                        f"这封信只报告收件路由变化：不授予任何额外权限、不替人开始工作、不移动已投递的信。",
                        1800, bid=bid, only=pending_boxes, done_set=landed)
                    ev["broadcast"] = bid
                    ev["sent"] = sorted(set(ev["sent"]) | landed)
                    log("postman.log", f"alias 切换广播 {bid} → {notify_boxes}"
                                       f"（已送达 {len(ev['sent'])}/{len(notify_boxes)}）")
                except Exception as e:
                    # Letters that landed before the failure count as delivered, so the retry only
                    # reaches the recipients that never got one; the event keeps the same bid.
                    ev["broadcast"] = bid
                    ev["sent"] = sorted(set(ev["sent"]) | landed)
                    steps_ok = False
                    log("postman.log", f"alias @{name} 切换广播未完成（已送达 {len(ev['sent'])}/"
                                       f"{len(notify_boxes)}）：{e}")
                    notify_once(f"switch::{ev['id']}::bcast", "联络总站：切换广播失败",
                                f"@{name} {confirmed or '（无）'} → {target or '（无）'}：{e}；下轮重试")
            save_alias_state(st)
        if steps_ok and ev["handoff"] is None:        # step 2: tell the new target (path only, never read)
            if not target or target not in routes:
                ev["handoff"] = "-"                  # nobody to hand over to
            else:
                # Same resumable identity as the broadcast: the note carries the event id in its
                # header, so an interrupt between "the note landed" and "the state write" resumes by
                # finding the note itself instead of sending a second one.
                prior = letter_tagged(target, "切换事件：", ev["id"])
                if prior is not None:
                    ev["handoff"] = prior.stem
                    log("postman.log", f"alias @{name} 交接提醒已存在（{prior.name}）→ {target}，不重投")
                else:
                    try:
                        path = write_letter(target, "postoffice", f"交接：@{name} 现在由你受理", "仅告知",
                                            f"逻辑地址 @{name} 现在由你受理。\n\n"
                                            f"之前：{confirmed or '（无在线候选）'}\n"
                                            f"原因：{reason}\n"
                                            f"交接路径：{spec.get('handoff') or '（未配置）'}\n\n"
                                            f"这封提醒只报告收件路由变化：不授予你额外权限、不自动开始任务、"
                                            f"已投递的旧信不会搬走。",
                                            extra_headers=[f"切换事件：{ev['id']}"])
                        ev["handoff"] = path.stem
                        log("postman.log", f"alias 交接提醒 {path.name} → {target}")
                    except Exception as e:
                        steps_ok = False
                        log("postman.log", f"alias @{name} 交接提醒失败：{e}")
                        notify_once(f"switch::{ev['id']}::handoff", "联络总站：交接提醒失败",
                                    f"@{name} → {target}：{e}；下轮重试")
            save_alias_state(st)
        if not steps_ok:                              # resume this same event next round; never start a new one
            continue
        if not ev["notified"]:                        # step 3: the human hears about it exactly once
            notify("联络总站：逻辑地址已切换",
                   f"@{name}：{confirmed or '（无在线候选）'} → {target or '（无在线候选）'}（{reason}）")
            ev["notified"] = True
        ev["done"] = True
        log(SWITCH_LOG, f"{ev['id']} alias=@{name} 前={confirmed or '（无在线候选）'} "
                        f"后={target or '（无在线候选）'} 原因={reason} "
                        f"通知={'、'.join(notify_boxes) or '无'} "
                        f"交接={target if ev['handoff'] not in (None, '-') else '无'}")
        a.update(confirmed=target, pending=None, pending_since=0.0, idle_announced=True)
        dirty = True
    if dirty:
        save_alias_state(st)


def disp_width(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def pad(text, width):
    return text + " " * max(0, width - disp_width(text))


