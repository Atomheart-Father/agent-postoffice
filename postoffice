def delivery_snapshot(routes):
    """{box: {"reminded": set(file), "failed": set(file)}} read once from the existing ledgers.

    "Reminded" means the channel accepted the reminder, per channel: the Claude `.seen` file, the
    OpenCode plugin's DELIVERED rows, and the postman's `.woken.json` (accept records). `.delivered.json`
    is deliberately not read — it also holds the 20-minute fallback marks, which are not reminders —
    and FAILED_FINAL is never counted as delivered. One snapshot feeds both the counts and the list so
    the panel cannot show two different stories. No new state store.
    """
    out = {}
    woken = {}
    wf = HOME / ".woken.json"
    if wf.exists():
        try:
            data = json.loads(wf.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                woken = data
        except ValueError:
            woken = {}
    oc = {}
    ledger = HOME / "opencode_delivered.jsonl"
    if ledger.exists():
        for line in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("box") and e.get("file"):
                oc.setdefault(e["box"], []).append((e.get("result"), e["file"]))
    for name, r in routes.items():
        method = r.get("methods", ["notify"])[0]
        reminded, failed = set(), set()
        if method == "claude_hook":
            seen = read_lines(HOME / name / ".seen")
            reminded = {p.name for p in pending(name) if str(p) in seen}
        elif method == "opencode_plugin":
            for result, fname in oc.get(name, []):
                if result == "DELIVERED":
                    reminded.add(fname)
                elif result == "FAILED_FINAL":
                    failed.add(fname)
        else:
            reminded = {Path(k).name for k in woken
                        if Path(k).parent.parent.name == name and (HOME / name / "inbox" / Path(k).name).is_file()}
        out[name] = {"reminded": reminded, "failed": failed}
    return out


def mail_state(name, snap):
    """One letter's delivery status plus the box's three counts, from the same snapshot."""
    s = snap.get(name, {"reminded": set(), "failed": set()})
    letters, counts = [], {"waiting": 0, "reminded": 0, "failed": 0}
    for p in pending(name):
        if p.name in s["reminded"]:
            status = "reminded"
        elif p.name in s["failed"]:
            status = "failed"
        else:
            status = "waiting"
        counts[status] += 1
        letters.append({"file": p.name, "status": status,
                        "subject": field(p, "事由").replace("事由：", "")[:60],
                        "from": field(p, "来源").replace("来源：", "").split("（")[0][:30],
                        "mtime": int(p.stat().st_mtime)})
    return letters, counts


def outbox_rows(operator):
    """Read model: the operator's still-observable outgoing ordinary mail, derived at request time.

    Scans every registered box's inbox/ for ordinary direct letters whose 来源 is the operator
    (derived notices are excluded the same way the edit/retract core excludes them). Pure read:
    never claims, never writes, never re-resolves an alias -- the frozen 逻辑地址： header is shown
    as-is. The row status is the very same mutation arbitration the edit/retract core uses, so a
    row that says pending can still lose the race to a delivery (the POST re-checks and fails closed).
    """
    if not operator:
        return []
    routes = boxes(load_routes())
    rows = []
    for to, r in routes.items():
        methods = r.get("methods", ["notify"])
        for p in pending(to):
            if letter_sender(p) != operator:      # 只列 operator 发的；来源读不出或别人的都不进
                continue
            if not is_ordinary_direct(p):          # 与 edit/retract 共用同一套普通直发信判定
                continue
            detail, err = read_letter_detail(to, p.stem)
            if err or not detail:
                continue
            alias_line = field(p, "逻辑地址：")
            state, reason = mutation_state(to, p, methods)
            rows.append({"to": to, "id": p.stem, "ref": f"{to}/{p.stem}",
                         "subject": detail["subject"], "need": detail["need"], "body": detail["body"],
                         "alias": alias_line[len("逻辑地址："):].strip() if alias_line else "",
                         "mtime": int(p.stat().st_mtime), "status": state, "reason": reason})
    rows.sort(key=lambda x: x["mtime"], reverse=True)
    return rows


def panel_state():
    rows = []
    full = load_routes()
    routes = boxes(full)
    snap = delivery_snapshot(routes)
    cfg, cfg_err = load_config()
    if cfg is None:                 # no usable config: physical facts still show, org stays silent
        cfg_ok, id_err = False, cfg_err or ""
    else:
        id_errs = config_errors(cfg, full) + org_errors(cfg, full)
        cfg_ok, id_err = (not id_errs), "；".join(id_errs[:4])
    for name, r in routes.items():
        m = r.get("methods", ["notify"])[0]
        letters, counts = mail_state(name, snap)
        act, act_since = activity_state(name, r)
        # the panel shows the SAME derived identity as CONTACT / CLI / harness hints
        ident = identity_snapshot(name, full, cfg or {}, ok=cfg_ok, error=id_err)
        rows.append({
            "name": name, "app": APP.get(m, m), "method": m, "who": route_display_name(r),
            "online": online(r),
            "ident": r.get("claude_title") or r.get("session_id") or r.get("thread_id") or "",
            "pending": letters, "counts": counts,
            "activity": {"state": act, "since": act_since},
            "identity": ident,
            "acks": recent_acks(name),
        })
    lines = []
    for f in ("postman.log", "claude_hook.log", "opencode_plugin.log"):
        lf = LOGS / f
        if lf.exists():
            for line in lf.read_text(encoding="utf-8", errors="replace").splitlines()[-40:]:
                if "未登记会话" in line:
                    continue
                t = line[:19].replace("T", " ")
                if f == "opencode_plugin.log":     # ISO UTC → local
                    try:
                        t = datetime.datetime.fromisoformat(line[:23].replace("Z", "+00:00")).astimezone() \
                            .strftime("%Y-%m-%d %H:%M:%S")
                        line = t + line[24:]
                    except ValueError:
                        pass
                lines.append((t, f.split(".")[0], line[20:]))
    lines.sort()
    return {"home": str(HOME), "boxes": rows, "broadcasts": broadcast_rows(),
            "groups": group_rows(routes, snap), "aliases": alias_rows(), "switches": switch_rows(),
            "config": str(CONFIG) if cfg is not None else "", "config_error": cfg_err,
            "panel": panel_config(),
            "log": [{"t": t, "src": s, "msg": m} for t, s, m in lines[-40:]][::-1]}


def panel_base_origin(base):
    """The exact Origin a browser would send for the panel's public base URL, else sys.exit.

    scheme must be http/https, a host is required, embedded user:pass is refused; the port is
    kept only when it is not the scheme's default. Empty/absent input means the feature is off.
    """
    if not base:
        return ""
    from urllib.parse import urlsplit
    u = urlsplit(base)
    if u.scheme not in ("http", "https"):
        sys.exit(f"POSTOFFICE_PANEL_BASE_URL 不合法：{base!r}（要以 http:// 或 https:// 开头）")
    if u.username or u.password:
        sys.exit(f"POSTOFFICE_PANEL_BASE_URL 不合法：{base!r}（不许携带用户名密码）")
    if not u.hostname:
        sys.exit(f"POSTOFFICE_PANEL_BASE_URL 不合法：{base!r}（要有主机名）")
    try:
        uport = u.port
    except ValueError:
        sys.exit(f"POSTOFFICE_PANEL_BASE_URL 不合法：{base!r}（端口不是数字）")
    host = f"[{u.hostname}]" if ":" in u.hostname else u.hostname
    default = 80 if u.scheme == "http" else 443
    return f"{u.scheme}://{host}" + (f":{uport}" if uport and uport != default else "")


def cmd_panel(a):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    import webbrowser
    trusted = panel_base_origin(PANEL_BASE_URL)
    html = (REPO / "panel" / "index.html").read_bytes()
    port = a.port

    class H(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def _send(self, code, body, ctype="application/json; charset=utf-8"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _local(self):
            # only our own page may change things (blocks other websites from poking localhost);
            # PANEL_BASE_URL adds one more exact origin, never a wildcard or suffix match
            origin = self.headers.get("Origin")
            if trusted and origin == trusted:
                return True
            return origin in (None, f"http://127.0.0.1:{port}", f"http://localhost:{port}")

        def _letter(self):
            """GET /api/letter：纯读单封信。只认已登记信箱里的裸编号，只读 inbox/<id>.md。"""
            from urllib.parse import urlsplit, parse_qs
            q = parse_qs(urlsplit(self.path).query)
            box = q["box"][0] if len(q.get("box") or []) == 1 else ""
            lid = q["id"][0] if len(q.get("id") or []) == 1 else ""
            if not box or not lid or not letter_id_ok(lid):
                return 400, {"ok": False, "error": "bad_request"}
            if not box_name_ok(box) or box not in boxes(load_routes()):
                return 404, {"ok": False, "error": "not_found"}
            detail, err = read_letter_detail(box, lid)
            if err:
                return 404, {"ok": False, "error": "not_found"}
            return 200, {"ok": True, **detail}

        def _page(self):
            # 每次请求都重读页面文件：改了 panel/index.html 刷新浏览器就生效，不用重启面板；
            # 读不到（文件被替换的瞬间等）就退回启动时读到的那份，面板不会因此打不开。
            nonlocal html
            try:
                html = (REPO / "panel" / "index.html").read_bytes()
            except OSError:
                pass
            return html

        def do_GET(self):
            if self.path.split("?", 1)[0] in ("/", "/index.html"):
                self._send(200, self._page(), "text/html; charset=utf-8")
            elif self.path == "/api/state":
                self._send(200, json.dumps(panel_state(), ensure_ascii=False).encode())
            elif self.path.split("?", 1)[0] == "/api/letter":
                status, payload = self._letter()
                self._send(status, json.dumps(payload, ensure_ascii=False).encode())
            elif self.path == "/api/outbox":
                # 纯读：operator 仍可观察的已发普通信，从真实状态推导，不落任何一份副本
                op = panel_config().get("operator") or ""
                self._send(200, json.dumps({"ok": True, "outbox": outbox_rows(op)},
                                           ensure_ascii=False).encode())
            else:
                self._send(404, b"{}")

        def do_POST(self):
            if self.path not in ("/api/status", "/api/clear", "/api/archive-one", "/api/ack-one", "/api/send",
                                 "/api/edit-one", "/api/retract-one") \
                    or not self._local() \
                    or self.headers.get("Content-Type", "").split(";")[0] != "application/json":
                # 先把请求体排空再拒绝：带着未读数据关连接会让内核发 RST，客户端
                # 偶尔拿不到这条 403（浏览器变成网络错误，测试偶发 ConnectionReset）。
                try:
                    n = int(self.headers.get("Content-Length", 0) or 0)
                    if 0 < n <= 1 << 20:
                        self.rfile.read(n)
                except (ValueError, OSError):
                    pass
                return self._send(403, b'{"ok":false}')
            message, status, payload, refused = "", None, None, ""
            try:
                d = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                if not isinstance(d, dict):
                    d = {}                  # 不是对象就当空对象：缺参路径统一处理
                if self.path == "/api/archive-one":
                    # 单封「处理完成」：inbox→done；与 clear（整箱收进 archived/）是两回事
                    box, lid = d.get("box"), d.get("id")
                    if not isinstance(box, str) or not isinstance(lid, str) or not box or not lid \
                            or not letter_id_ok(lid):
                        ok, status, message = False, 400, "bad_request"
                    elif not box_name_ok(box) or box not in boxes(load_routes()):
                        ok, status, message = False, 404, "not_found"
                    else:
                        try:
                            state = letter_done_state(box, lid)
                        except OSError:
                            state = "failed"
                        if state in ("moved", "already"):
                            ok = True
                            payload = {"ok": True, "state": state}
                            log("postman.log", f"面板：单封归档 {box}/{lid}（{state}）")
                        elif state == "conflict":
                            ok, status, message = False, 409, "conflict"
                        else:
                            ok, status, message = False, 404, "not_found"
                elif self.path == "/api/ack-one":
                    # 单封回执（后端 seam，本票不上面板 UI）：与 CLI `ack` 共用 ack_letter 核心；
                    # 重复调用是幂等的，不会产生第二份回执
                    box, lid, note = d.get("box"), d.get("id"), d.get("note", "")
                    if not isinstance(note, str):
                        ok, status, message = False, 400, "bad_request"
                    elif not isinstance(box, str) or not isinstance(lid, str) or not box or not lid \
                            or not letter_id_ok(lid):
                        ok, status, message = False, 400, "bad_request"
                    elif not box_name_ok(box) or box not in boxes(load_routes()):
                        ok, status, message = False, 404, "not_found"
                    else:
                        try:
                            state, info, _lines = ack_letter(box, lid, note)
                            ok = True
                            payload = {"ok": True, "state": state, "id": info["id"], "to": info["to"]}
                            log("postman.log", f"面板：单封回执 {box}/{info['id']}（{state}）")
                        except SystemExit as e:
                            ok, status, message, refused = False, 400, "refused", str(e)
                        except OSError:
                            ok, status, message = False, 500, "failed"
                elif self.path == "/api/send":
                    # 发信（后端 seam）：与 CLI `send` 共用 resolve_send_target + send_letter；
                    # @逻辑地址的 first-online / 全离线拒绝都走同一份核心，面板不自己实现解析
                    sender, to_arg = d.get("from"), d.get("to")
                    subject, need, body = d.get("subject"), d.get("need"), d.get("body")
                    if not all(isinstance(x, str) for x in (sender, to_arg, subject, need, body)) \
                            or not sender or not to_arg:
                        ok, status, message = False, 400, "bad_request"
                    elif not box_name_ok(sender) or sender not in boxes(load_routes()):
                        ok, status, message = False, 404, "not_found"
                    elif not to_arg.startswith("@") and not box_name_ok(to_arg):
                        ok, status, message = False, 404, "not_found"
                    else:
                        try:
                            routes = load_routes()
                            to, _lines = resolve_send_target(to_arg, routes)
                            path = send_letter(sender, to, subject, need, body,
                                               alias=to_arg if to_arg.startswith("@") else None)
                            ok = True
                            payload = {"ok": True, "id": path.stem, "ref": f"{to}/{path.stem}"}
                            log("postman.log", f"面板：发信 {sender} → {to}（{path.stem}）")
                        except SystemExit as e:
                            ok, status, message, refused = False, 400, "refused", str(e)
                        except OSError:
                            ok, status, message = False, 500, "failed"
                elif self.path in ("/api/edit-one", "/api/retract-one"):
                    # 与 CLI edit/retract 共用 mutation_target/apply_mutation 核心：sender 只来自
                    # config.panel.operator，浏览器传 from/sender 一概不作数；每次 POST 都重新
                    # 走 claim→复检→mutation，所以列表快照说 pending 也可能在竞争里失败（fail closed）
                    op = panel_config().get("operator") or ""
                    box, lid = d.get("to"), d.get("id")
                    if not isinstance(box, str) or not isinstance(lid, str) or not box or not lid \
                            or not letter_id_ok(lid):
                        ok, status, message = False, 400, "bad_request"
                    elif not box_name_ok(box) or box not in boxes(load_routes()):
                        ok, status, message = False, 404, "not_found"
                    elif not (HOME / box / "inbox" / f"{lid}.md").is_file():
                        ok, status, message = False, 404, "not_found"
                    elif not op:
                        ok, status, message, refused = False, 400, "refused", "面板没有配置 operator，不能改信或撤回"
                    elif self.path == "/api/edit-one":
                        fields = {k: d.get(k) for k in ("subject", "need", "body")}
                        if any(v is not None and not isinstance(v, str) for v in fields.values()) \
                                or all(v is None for v in fields.values()):
                            ok, status, message = False, 400, "bad_request"
                        else:
                            try:
                                routes = boxes(load_routes())
                                path, methods = mutation_target(box, lid, op, routes, "edit")
                                info = apply_mutation(
                                    "edit", box, path, methods, subject=fields["subject"],
                                    need=None if fields["need"] is None else clean_need(fields["need"]),
                                    body=fields["body"])
                                ok = True
                                payload = {"ok": True, "state": "updated", "id": info["id"], "to": box}
                                log("postman.log", f"面板：改信 {op} → {box}/{info['id']}（通道未接受，原地改）")
                            except SystemExit as e:
                                ok, status, message, refused = False, 400, "refused", str(e)
                            except OSError:
                                ok, status, message = False, 500, "failed"
                    else:
                        try:
                            routes = boxes(load_routes())
                            path, methods = mutation_target(box, lid, op, routes, "retract")
                            info = apply_mutation("retract", box, path, methods)
                            ok = True
                            payload = {"ok": True, "state": "retracted", "id": info["id"], "to": box}
                            log("postman.log", f"面板：撤回 {op} → {box}/{info['id']}（通道未接受，原信存档）")
                        except SystemExit as e:
                            ok, status, message, refused = False, 400, "refused", str(e)
                        except OSError:
                            ok, status, message = False, 500, "failed"
                elif self.path == "/api/clear":
                    name = str(d["name"])
                    ok = name in boxes(load_routes())
                    if ok:
                        _, n = clear_backlog(name)
                        log("postman.log", f"面板：清空 {name} 积压 {n} 封")
                elif d.get("group"):        # group button: same transition rules, same origin check
                    set_group_status("@" + str(d["group"]), str(d["status"]), quiet=True)
                    ok = True
                else:
                    name = str(d["name"])
                    ok = apply_status(name, str(d["status"]))
                    if ok:
                        log("postman.log", f"面板：{name} 设为{'在线' if d['status'] == 'online' else '离线'}")
            except (ValueError, KeyError):
                ok = False
                if self.path == "/api/archive-one":
                    status, message = 400, "bad_request"
            except SystemExit as e:        # an unknown group or a missing member: say why, change nothing
                ok, message = False, str(e)
            if payload is None:
                payload = {"ok": ok, "error": message if not ok else ""}
                if not ok and refused:
                    payload["message"] = refused
            self._send(status or (200 if ok else 400), json.dumps(payload).encode())

    try:
        srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    except OSError:
        # an older panel still holding the port: replace it; anything else: explain instead of a traceback
        r = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"], capture_output=True, text=True)
        old = []
        for x in r.stdout.split():
            cmd = subprocess.run(["ps", "-o", "command=", "-p", x], capture_output=True, text=True).stdout
            if "postoffice" in cmd and " panel" in cmd and int(x) != os.getpid():
                old.append(int(x))
        if not old:
            sys.exit(f"端口 {port} 被别的程序占用了，换一个：postoffice panel --port 8766")
        for pid in old:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        print(f"已关闭旧面板（pid {', '.join(map(str, old))}），换成新版")
        for _ in range(20):
            time.sleep(0.25)
            try:
                srv = ThreadingHTTPServer(("127.0.0.1", port), H)
                break
            except OSError:
                continue
        else:
            sys.exit(f"旧面板没能关掉，端口 {port} 仍被占用")
    url = f"http://127.0.0.1:{port}/"
    if trusted:
        # One canonical entry, so a per-origin browser preference (the colour choice in localStorage) is the
        # same whether the human opens the printed URL or arrives from a Slack deep link. Without this the
        # local URL and the public URL are two different origins, i.e. two separate preference buckets.
        print(f"联络总站面板：{PANEL_BASE_URL}/（Ctrl+C 关闭；本机备用 {url}）", flush=True)
        print(f"写操作只认同源 Origin：{trusted}", flush=True)
        if not a.no_open:
            webbrowser.open(f"{PANEL_BASE_URL}/")
    else:
        print(f"联络总站面板：{url}（Ctrl+C 关闭）", flush=True)
        if not a.no_open:
            webbrowser.open(url)
    srv.serve_forever()

def group_or_box(a, status):
    """`online`/`offline`: @GROUP switches the whole group, a plain name stays a single mailbox."""
    if a.name.startswith("@"):
        set_group_status(a.name, status)
    else:
        set_status(a.name, status)
    return 0


