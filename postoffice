def backup(path):
    if path.exists():
        dst = LOGS / f"{path.name}.{time.strftime('%Y%m%d-%H%M%S')}.bak"
        LOGS.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, dst)
        return dst
    return None


def is_ours(cmd):
    return "claude_hook.sh" in cmd \
        or ("postoffice" in cmd and (cmd.rstrip().endswith(" hook") or " activity " in cmd
                                     or " identity " in cmd))


def cmd_install_claude(_a):
    s = Path.home() / ".claude" / "settings.json"
    s.parent.mkdir(parents=True, exist_ok=True)
    cfg = json.loads(s.read_text(encoding="utf-8")) if s.exists() and s.read_text().strip() else {}
    bk = backup(s)
    # Claude Code docs say async hooks are not timed out, but the settings schema documents a 600 s default
    # for command hooks; set an explicit long timeout so neither reading can kill the watcher after 10 min.
    ours = {"type": "command", "command": f'exec "{SELF}" hook', "asyncRewake": True, "timeout": HOOK_TIMEOUT}
    # Resume seam: SessionStart prints the short identity hint as additional context (silent when the
    # session cannot be resolved to exactly one claude_hook box -- then the skill's query path applies).
    hint = {"type": "command", "command": f'exec "{SELF}" identity --hint', "timeout": 30}
    hooks = cfg.setdefault("hooks", {})
    entries = [("Stop", {}, [ours]),
               ("SessionStart", {"matcher": "startup|resume|clear|compact"}, [ours, hint]),
               # 每次提交提示前记一次 working：这是 Claude 侧最诚实的「正在干活」信号（同步钩子，失败静默）
               ("UserPromptSubmit", {}, [{**ours, "command": f'exec "{SELF}" activity --state working'}])]
    for event, extra, our_hooks in entries:
        groups = []
        for g in hooks.get(event, []):
            g = dict(g)
            g["hooks"] = [h for h in g.get("hooks", []) if not is_ours(h.get("command", ""))]
            if g["hooks"]:
                groups.append(g)
        groups.append(dict(extra, hooks=our_hooks))
        hooks[event] = groups
    s.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"Claude Code 钩子已装入 {s}" + (f"（原文件备份：{bk}）" if bk else ""))


def cmd_uninstall_claude(_a):
    s = Path.home() / ".claude" / "settings.json"
    if not s.exists():
        return
    cfg = json.loads(s.read_text(encoding="utf-8"))
    backup(s)
    for event in ("Stop", "SessionStart", "UserPromptSubmit"):
        groups = []
        for g in cfg.get("hooks", {}).get(event, []):
            g["hooks"] = [h for h in g.get("hooks", []) if not is_ours(h.get("command", ""))]
            if g["hooks"]:
                groups.append(g)
        if "hooks" in cfg:
            cfg["hooks"][event] = groups
            if not groups:
                del cfg["hooks"][event]
    if cfg.get("hooks") == {}:
        del cfg["hooks"]
    s.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print("已移除 Claude Code 收信钩子")


def opencode_config_dir():
    return Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "opencode"


def cli_link_path():
    return Path.home() / ".local" / "bin" / "postoffice"


def link_postoffice_cli():
    """把 ~/.local/bin/postoffice 换成指向“执行本安装的那份 checkout”，成功与否如实返回。

    装好的插件不在 checkout 里，它在 $XDG_CONFIG_HOME/opencode/plugins/ 下，只能通过这个 symlink
    找到写闹钟记录的那个 CLI —— CLI 本身单文件 Python 留在 checkout 里。所以谁装了这个插件，谁的
    CLI 就必须是它，否则插件版本与 CLI 版本会各走各的。在 A checkout 里 install 再到 B 里 install，
    插件与 symlink 会一起切到 B。

    返回 (是否成功, 细节, 旧目标或 None)。**这个函数先换链接、不碰插件**，所以它失败时磁盘上
    一位都没动过：旧插件还配旧链接，仍是自洽的一对。这条顺序是硬要求 —— 先覆盖插件再试着改链接的
    写法，链接一失败就会把新插件留在旧 checkout 的链接上，正好制造出要避免的错配。

    幂等：已经指着 SELF 就不做任何改动。这不是新增状态文件，只是把 install.sh 早就在做的事
    （ln -sfn）也放进 `postoffice install opencode`，好让单独跑这个子命令也自洽。
    新链接先写在临时名上再 rename 换过去，换的动作是原子的：失败时旧链接原封不动。
    """
    link = cli_link_path()
    want = str(SELF)
    try:
        have = os.readlink(link) if link.is_symlink() else ""
        if have == want:
            return True, f"{link} 已经指向 {want}", have
        if link.is_dir() and not link.is_symlink():
            return False, f"{link} 已经是一个目录，换不动", have or None
        link.parent.mkdir(parents=True, exist_ok=True)
        tmp = link.with_name(link.name + f".tmp-{os.getpid()}")
        tmp.unlink(missing_ok=True)
        tmp.symlink_to(want)
        if link.is_symlink() or link.exists():
            backup(link)
        os.replace(tmp, link)          # 从这一行起链接已指向本 checkout
    except OSError as e:
        return False, f"{link} 没能指向 {want}（{e}）", None
    return True, f"{link} → {want}", have or None


def restore_cli_link(prev):
    """把链接放回安装前的指向；之前没有链接就把它撤掉。

    只在“链接已经换过去、但插件没复制成功”时用：那一刻链接是新 checkout 的、插件还是旧的，
    必须撤掉新链接才能回到配对状态，否则这次安装就留下了一个错配。
    """
    link = cli_link_path()
    try:
        if prev is None:
            link.unlink(missing_ok=True)
            return
        tmp = link.with_name(link.name + f".rollback-{os.getpid()}")
        tmp.unlink(missing_ok=True)
        tmp.symlink_to(prev)
        os.replace(tmp, link)
    except OSError as e:
        print(f"⚠️  回滚 {link} 到 {prev} 失败（{e}）。请手工把它指回安装前的那份 CLI。")


def cmd_install_opencode(_a):
    d = opencode_config_dir()
    plug = d / "plugins"
    plug.mkdir(parents=True, exist_ok=True)
    dst = plug / "postoffice.ts"
    # 先把链接对齐，再覆盖插件（顺序是硬要求，见 link_postoffice_cli 的说明）：链接这一步失败时
    # 磁盘一位都没动，装好的那份插件仍配它自己的链接；插件复制失败时把链接撤回，同样不留错配。
    linked, detail, prev = link_postoffice_cli()
    if not linked:
        print(f"❌ 没有安装：CLI 链接没能更新成同源的一份，所以插件一个字节都没动（{dst} 保持原样）。")
        print(f"   原因：{detail}")
        print(f"   此刻磁盘上的插件与它原本的链接仍是一对，只是这次装的是 {REPO} 这份，没装成。")
        print(f"   修法：让 {cli_link_path()} 指向 {SELF}，或设 POSTOFFICE_CLI={SELF}，再重跑一次本命令。")
        sys.exit(1)
    try:
        tmp = dst.with_name(dst.name + f".tmp-{os.getpid()}")
        shutil.copy2(REPO / "opencode" / "postoffice.ts", tmp)   # 先写临时名，失败就不会截断已装的插件
        os.replace(tmp, dst)
    except OSError as e:
        restore_cli_link(prev)
        print(f"❌ 没有安装：插件没能复制到 {dst}（{e}）。")
        print(f"   CLI 链接已撤回到安装前的那一份，所以插件与链接仍然同源。")
        sys.exit(1)
    print(f"OpenCode 插件已装入 {dst}（重启 OpenCode 生效）")
    print(f"CLI 已就位：{detail}（插件与 CLI 同源于 {REPO}）")
    # let OpenCode agents read/write the mailbox without a permission prompt each time
    for name in ("opencode.json", "opencode.jsonc"):
        cfgf = d / name
        if cfgf.exists():
            break
    else:
        cfgf = d / "opencode.json"
    try:
        cfg = json.loads(cfgf.read_text(encoding="utf-8")) if cfgf.exists() else {"$schema": "https://opencode.ai/config.json"}
    except ValueError:
        print(f"提示：{cfgf} 含注释，未自动修改。想免去读信时的权限确认，请在 permission.external_directory 里加："
              f'"{HOME}/**": "allow"')
        if not linked:
            sys.exit(1)
        return
    perm = cfg.setdefault("permission", {})
    ext = perm.get("external_directory")
    if isinstance(ext, str):
        ext = {"*": ext}
    ext = ext or {}
    key = f"{HOME}/**"
    if ext.get(key) != "allow":
        bk = backup(cfgf)
        ext[key] = "allow"
        perm["external_directory"] = ext
        cfgf.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        print(f"已允许 OpenCode 读写 {HOME}（{cfgf}" + (f"，备份 {bk}）" if bk else "）"))


