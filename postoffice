def recent_acks(name, limit=3):
    rows = [e for e in read_acks() if e.get("to") == name]
    return [{"time": e.get("time", ""), "by": e.get("by", ""), "note": e.get("note", ""),
             "kind": e.get("kind", ""), "id": e.get("id", "")} for e in reversed(rows)][:limit]


def broadcast_rows(limit=10):
    acks = read_acks()
    rows = []
    bdir = broadcasts_dir()
    if bdir.is_dir():
        for f in sorted(bdir.glob("*.json"), reverse=True):
            rec = read_json(f)
            if not rec:
                continue
            dl = float(rec.get("deadline", 0) or 0)
            acked = sum(1 for e in acks
                        if e.get("id") == rec.get("id") and e.get("kind") == "broadcast")
            rows.append({
                "id": rec.get("id", f.stem), "subject": rec.get("subject", ""), "from": rec.get("from", ""),
                "acked": acked, "total": len(rec.get("to", [])),
                "summarized": rec.get("summarized") is True, "error": rec.get("summarized") == "error",
                "deadline": time.strftime("%m-%d %H:%M", time.localtime(dl)) if dl else "",
            })
            if len(rows) >= limit:
                break
    return rows


def panel_state():
    rows = []
    for name, r in boxes(load_routes()).items():
        m = r.get("methods", ["notify"])[0]
        rows.append({
            "name": name, "app": APP.get(m, m), "method": m, "who": r.get("who", ""),
            "online": online(r),
            "ident": r.get("claude_title") or r.get("session_id") or r.get("thread_id") or "",
            "pending": [{"file": p.name, "subject": field(p, "事由").replace("事由：", "")[:60],
                         "from": field(p, "来源").replace("来源：", "").split("（")[0][:30]} for p in pending(name)],
            "acks": recent_acks(name),
        })
    lines = []
    for f in ("postman.log", "claude_hook.log", "opencode_plugin.log"):
        lf = LOGS / f
        if lf.exists():
            for line in lf.read_text(encoding="utf-8", errors="replace").splitlines()[-40:]:
                if "未登记会话" in line:
                    continue
                t = line[:19].replace("T", " ")
                if f == "opencode_plugin.log":     # ISO UTC → local
                    try:
                        t = datetime.datetime.fromisoformat(line[:23].replace("Z", "+00:00")).astimezone() \
                            .strftime("%Y-%m-%d %H:%M:%S")
                        line = t + line[24:]
                    except ValueError:
                        pass
                lines.append((t, f.split(".")[0], line[20:]))
    lines.sort()
    return {"home": str(HOME), "boxes": rows, "broadcasts": broadcast_rows(),
            "log": [{"t": t, "src": s, "msg": m} for t, s, m in lines[-40:]][::-1]}


def cmd_panel(a):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    import webbrowser
    html = (REPO / "panel" / "index.html").read_bytes()
    port = a.port

    class H(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def _send(self, code, body, ctype="application/json; charset=utf-8"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _local(self):
            # only our own page may change things (blocks other websites from poking localhost)
            origin = self.headers.get("Origin")
            return origin in (None, f"http://127.0.0.1:{port}", f"http://localhost:{port}")

        def do_GET(self):
            if self.path in ("/", "/index.html"):
                self._send(200, html, "text/html; charset=utf-8")
            elif self.path == "/api/state":
                self._send(200, json.dumps(panel_state(), ensure_ascii=False).encode())
            else:
                self._send(404, b"{}")

        def do_POST(self):
            if self.path not in ("/api/status", "/api/clear") or not self._local() \
                    or self.headers.get("Content-Type", "").split(";")[0] != "application/json":
                return self._send(403, b'{"ok":false}')
            try:
                d = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                name = str(d["name"])
                if self.path == "/api/clear":
                    ok = name in boxes(load_routes())
                    if ok:
                        _, n = clear_backlog(name)
                        log("postman.log", f"面板：清空 {name} 积压 {n} 封")
                else:
                    ok = apply_status(name, str(d["status"]))
                    if ok:
                        log("postman.log", f"面板：{name} 设为{'在线' if d['status'] == 'online' else '离线'}")
            except (ValueError, KeyError):
                ok = False
            self._send(200 if ok else 400, json.dumps({"ok": ok}).encode())

    try:
        srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    except OSError:
        # an older panel still holding the port: replace it; anything else: explain instead of a traceback
        r = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"], capture_output=True, text=True)
        old = []
        for x in r.stdout.split():
            cmd = subprocess.run(["ps", "-o", "command=", "-p", x], capture_output=True, text=True).stdout
            if "postoffice" in cmd and " panel" in cmd and int(x) != os.getpid():
                old.append(int(x))
        if not old:
            sys.exit(f"端口 {port} 被别的程序占用了，换一个：postoffice panel --port 8766")
        for pid in old:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        print(f"已关闭旧面板（pid {', '.join(map(str, old))}），换成新版")
        for _ in range(20):
            time.sleep(0.25)
            try:
                srv = ThreadingHTTPServer(("127.0.0.1", port), H)
                break
            except OSError:
                continue
        else:
            sys.exit(f"旧面板没能关掉，端口 {port} 仍被占用")
    url = f"http://127.0.0.1:{port}/"
    print(f"联络总站面板：{url}（Ctrl+C 关闭）", flush=True)
    if not a.no_open:
        webbrowser.open(url)
    srv.serve_forever()

def main():
    ap = argparse.ArgumentParser(prog="postoffice", description="本机 AI 会话之间的邮局（Claude Code / OpenCode / Codex）")
    ap.add_argument("--version", action="version", version=VERSION)
    sp = ap.add_subparsers(dest="cmd")
    sp.add_parser("init", help="建好邮局目录").set_defaults(fn=cmd_init)
    p = sp.add_parser("add", help="登记/更新一个信箱")
    p.add_argument("name")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--claude", metavar="会话标题", help="Claude Code 会话（按会话标题认人）")
    g.add_argument("--opencode", metavar="会话标题或ID", help="OpenCode 会话")
    g.add_argument("--codex", metavar="THREAD_ID", help="Codex 线程")
    g.add_argument("--notify", action="store_true", help="没有自动通道，只弹通知给人")
    p.add_argument("--who", help="一句话说明这是谁")
    p.set_defaults(fn=cmd_add)
    p = sp.add_parser("remove", help="从通讯录移除")
    p.add_argument("name")
    p.set_defaults(fn=cmd_remove)
    p = sp.add_parser("online", help="设为在线（补送积压的信）")
    p.add_argument("name")
    p.set_defaults(fn=lambda a: set_status(a.name, "online"))
    p = sp.add_parser("offline", help="设为离线（照收信，不提醒）")
    p.add_argument("name")
    p.set_defaults(fn=lambda a: set_status(a.name, "offline"))
    p = sp.add_parser("clear", help="清空积压：把还没送出的信存档到 archived/，不再投递")
    p.add_argument("name")
    p.set_defaults(fn=cmd_clear)
    p = sp.add_parser("send", help="发信：正文从标准输入或 --file")
    p.add_argument("to")
    p.add_argument("sender")
    p.add_argument("subject")
    p.add_argument("need")
    p.add_argument("--file")
    p.set_defaults(fn=cmd_send)
    p = sp.add_parser("ack", help="回执记账：把信挪进 done/，不叫醒发信方（--wake 才发 copy that）")
    p.add_argument("name")
    p.add_argument("id", metavar="信件编号|广播编号")
    p.add_argument("note", nargs="?", default="", help="一句话")
    p.add_argument("--wake", action="store_true", help="另发一封 copy that 给原发信方（会叫醒）")
    p.set_defaults(fn=cmd_ack)
    p = sp.add_parser("broadcast", help="广播：给多个信箱各投一封带编号的信，回执汇总成一封给发信方")
    p.add_argument("to", help="收件信箱，逗号分隔；all = 除发信方外全部")
    p.add_argument("sender")
    p.add_argument("subject")
    p.add_argument("need")
    p.add_argument("--deadline", help="截止时间，如 30m / 90s / 2h（默认 30m）")
    p.add_argument("--file")
    p.set_defaults(fn=cmd_broadcast)
    sp.add_parser("list", help="通讯录与积压").set_defaults(fn=cmd_list)
    sp.add_parser("hook", help="（内部）Claude Code 钩子入口").set_defaults(fn=cmd_hook)
    sp.add_parser("postman", help="前台运行邮递员").set_defaults(fn=cmd_postman)
    sp.add_parser("doctor", help="体检").set_defaults(fn=cmd_doctor)
    p = sp.add_parser("panel", help="打开网页操作面板（开关各会话的连接）")
    p.add_argument("--port", type=int, default=8765)
    p.add_argument("--no-open", action="store_true", help="不自动打开浏览器")
    p.set_defaults(fn=cmd_panel)
    p = sp.add_parser("install", help="安装部件：claude / opencode / skill / postman")
    p.add_argument("part", choices=["claude", "opencode", "skill", "postman"])
    p.set_defaults(fn=lambda a: {"claude": cmd_install_claude, "opencode": cmd_install_opencode,
                                 "skill": cmd_install_skill, "postman": cmd_install_postman}[a.part](a))
    p = sp.add_parser("uninstall", help="卸载部件：claude / postman")
    p.add_argument("part", choices=["claude", "postman"])
    p.set_defaults(fn=lambda a: {"claude": cmd_uninstall_claude, "postman": cmd_uninstall_postman}[a.part](a))
    a = ap.parse_args()
    if not getattr(a, "fn", None):
        ap.print_help()
        return 0
    return a.fn(a) or 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\n已停止")
