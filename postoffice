def cmd_hook(_a):
    """Claude Code Stop / SessionStart hook (asyncRewake). Waits for mail; exit 2 wakes the session."""
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    tp = data.get("transcript_path")
    title = None
    if tp and Path(tp).exists():
        with open(tp, encoding="utf-8", errors="replace") as f:
            for line in f:
                if '"custom-title"' in line:
                    try:
                        title = json.loads(line).get("customTitle") or title
                    except ValueError:
                        pass
    if not title or not ROUTES.exists():
        return 0
    name = next((k for k, v in boxes(load_routes()).items()
                 if "claude_hook" in v.get("methods", []) and v.get("claude_title") == title), None)
    if not name:
        log("claude_hook.log", f"未登记会话「{title}」，不监视")
        return 0

    box = HOME / name
    pidf, seenf, alive = box / ".watch.pid", box / ".seen", box / ".watch_alive"
    me, owner = os.getpid(), os.getppid()
    try:
        old = int(pidf.read_text().strip())
        if old != me:
            os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    pidf.write_text(str(me))
    log("claude_hook.log", f"{name} 监视上岗 pid={me} owner={owner}")
    paused = False
    while True:
        try:
            if pidf.read_text().strip() != str(me):
                return 0                      # a newer watcher took over
        except OSError:
            return 0
        try:
            os.kill(owner, 0)
        except OSError:
            log("claude_hook.log", f"{name} 会话进程已退出，监视下岗")
            return 0
        alive.touch()
        r = boxes(load_routes()).get(name)
        if r is None:
            return 0
        if online(r):
            seen = read_lines(seenf)
            new = [p for p in pending(name) if str(p) not in seen]
            if new:
                if rate_ok(name):
                    sys.stderr.write(reminder(name, new) + "\n")
                    with seenf.open("a") as f:
                        f.writelines(f"{p}\n" for p in new)
                    rate_mark(name, len(new))
                    for p in new:
                        log("claude_hook.log", f"{name} 唤醒 {p.name}")
                    pidf.unlink(missing_ok=True)
                    return 2
                if not paused:
                    notify("联络总站：唤醒暂停", f"{name} 10 分钟内来信超过 {RATE_N} 封")
                    log("claude_hook.log", f"{name} 限流暂停")
                    paused = True
            else:
                paused = False
        time.sleep(POLL)


def cmd_postman(_a):
    """Delivers codex_queue / notify mailboxes and watches that hook/plugin mailboxes really got woken."""
    state = HOME / ".delivered.json"
    delivered = set(json.loads(state.read_text())) if state.exists() else set()
    throttled = set()
    log("postman.log", f"邮递员上岗 v{VERSION}")
    print(f"{now_str()} 邮递员上岗（{HOME}），Ctrl+C 停止", flush=True)

    wokef = HOME / ".woken.json"     # letter → time we saw it reminded (ACCEPTED); leaving inbox = CONSUMED
    woken = json.loads(wokef.read_text()) if wokef.exists() else {}

    def mark(key, reminded=True):
        delivered.add(key)
        state.write_text(json.dumps(sorted(delivered), ensure_ascii=False))
        if reminded:
            woken[key] = {"t": time.time(), "alerted": False}
            wokef.write_text(json.dumps(woken, ensure_ascii=False))

    def check_consumed(routes):
        changed = False
        for key in list(woken):
            p = Path(key)
            if not p.exists():                       # moved to done/ (or deleted): consumed
                del woken[key]
                changed = True
                continue
            w = woken[key]
            r = routes.get(p.parent.parent.name)
            if w["alerted"] or not r or not online(r) or time.time() - w["t"] < CONSUME_ALERT:
                continue
            notify(f"联络总站：{p.parent.parent.name} 已提醒但 {CONSUME_ALERT // 60} 分钟未处理",
                   (field(p, "事由") or p.name) + "（会话可能没加载、卡住或在忙长任务）")
            log("postman.log", f"未处理 {p.parent.parent.name} {p.name}：提醒后 {CONSUME_ALERT // 60} 分钟仍在 inbox，已通知人")
            w["alerted"] = True
            changed = True
        if changed:
            wokef.write_text(json.dumps(woken, ensure_ascii=False))

    while True:
        try:
            routes = boxes(load_routes())
        except Exception as e:
            log("postman.log", f"routes.json 读取失败：{e}")
            time.sleep(POLL)
            continue
        try:
            oc_ok = set()
            ledger = HOME / "opencode_delivered.jsonl"
            if ledger.exists():
                for line in ledger.read_text(encoding="utf-8").splitlines():
                    try:
                        e = json.loads(line)
                        if e.get("result") in ("DELIVERED", "FAILED_FINAL"):
                            oc_ok.add(f"{e['box']}::{e['file']}")
                    except (ValueError, KeyError):
                        pass
            check_consumed(routes)
            summarize_broadcasts(routes)
            for name, r in routes.items():
                if not online(r):
                    continue                  # offline: letters wait, nobody is reminded
                method = r.get("methods", ["notify"])[0]
                for p in pending(name):
                    key = str(p)
                    if key in delivered:
                        continue
                    if method in ("claude_hook", "opencode_plugin"):
                        done = (key in read_lines(HOME / name / ".seen")) if method == "claude_hook" \
                            else (f"{name}::{p.name}" in oc_ok)
                        if done:
                            log("postman.log", f"{method} {name} {p.name} 已送达")
                        elif time.time() - p.stat().st_mtime > GRACE:
                            notify(f"联络总站：{name} 20 分钟未被唤醒", field(p, "事由") or p.name)
                            log("postman.log", f"{method} {name} {p.name} 超 20 分钟未送达，已通知人")
                            mark(key, reminded=False)
                            continue
                        else:
                            continue
                        mark(key)
                        continue
                    if not rate_ok(name):
                        if name not in throttled:
                            notify("联络总站：投递暂停", f"{name} 10 分钟内信件过多")
                            log("postman.log", f"THROTTLE {name}")
                            throttled.add(name)
                        continue
                    throttled.discard(name)
                    ok = True
                    try:
                        if method == "codex_queue":
                            cli = r.get("codex_cli") or find_codex()
                            msg = reminder(name, [p])
                            res = subprocess.run([cli, "queue", "--thread", r["thread_id"], "--message", msg],
                                                 capture_output=True, text=True, timeout=60)
                            ok = res.returncode == 0
                            log("postman.log", f"codex_queue {name} {p.name} rc={res.returncode} "
                                               f"{res.stdout.strip()[:200]} {res.stderr.strip()[:200]}")
                        else:
                            notify(f"联络总站：给 {name} 的新信", field(p, "事由") or p.name)
                            log("postman.log", f"notify {name} {p.name}")
                    except Exception as e:
                        ok = False
                        log("postman.log", f"投递异常 {name} {p.name}: {e}")
                    if not ok:
                        notify("联络总站：投递失败", f"{name} {p.name}，请手动转交")
                    rate_mark(name)
                    mark(key, reminded=ok and method == "codex_queue")  # failures are not retried; the human was notified once
        except Exception as e:
            log("postman.log", f"邮递员本轮异常（已忽略，继续）：{e}")
        time.sleep(POLL)


