def recent_acks(name, limit=3):
    rows = [e for e in read_acks() if e.get("to") == name]
    return [{"time": e.get("time", ""), "by": e.get("by", ""), "note": e.get("note", ""),
             "kind": e.get("kind", ""), "id": e.get("id", "")} for e in reversed(rows)][:limit]


def broadcast_rows(limit=10):
    acks = read_acks()
    rows = []
    bdir = broadcasts_dir()
    if bdir.is_dir():
        for f in sorted(bdir.glob("*.json"), reverse=True):
            rec = read_json(f)
            if not rec:
                continue
            dl = float(rec.get("deadline", 0) or 0)
            acked = sum(1 for e in acks
                        if e.get("id") == rec.get("id") and e.get("kind") == "broadcast")
            rows.append({
                "id": rec.get("id", f.stem), "subject": rec.get("subject", ""), "from": rec.get("from", ""),
                "acked": acked, "total": len(rec.get("to", [])),
                "summarized": rec.get("summarized") is True, "error": rec.get("summarized") == "error",
                "deadline": time.strftime("%m-%d %H:%M", time.localtime(dl)) if dl else "",
            })
            if len(rows) >= limit:
                break
    return rows


def group_rows(routes=None, snap=None):
    """Groups with their online count and the same delivery counts as a mailbox."""
    cfg, _ = load_config()
    routes = boxes(load_routes()) if routes is None else routes
    snap = delivery_snapshot(routes) if snap is None else snap
    out = []
    for name, members in ((cfg or {}).get("groups") or {}).items():
        if not isinstance(members, list):
            continue
        counts = {"waiting": 0, "reminded": 0, "failed": 0}
        for m in members:
            _letters, c = mail_state(m, snap)
            for k in counts:
                counts[k] += c[k]
        out.append({"name": name, "members": members, "total": len(members),
                    "online": sum(1 for m in members if m in routes and online(routes[m])),
                    "counts": counts})
    return out


def alias_rows():
    """Where each logical address resolves right now, plus what is still inside its stability window."""
    cfg, _ = load_config()
    routes = boxes(load_routes())
    st = alias_state()
    out = []
    for name, raw in ((cfg or {}).get("aliases") or {}).items():
        spec, aerr = normalize_alias(raw)
        if spec is None or not isinstance(spec.get("candidates"), list):
            out.append({"name": name, "error": aerr or "candidates 必须是非空数组"})
            continue
        a = st["aliases"].get(name) or {}
        left = 0
        if a.get("pending") and a.get("pending_since"):
            left = max(0, int(ALIAS_STABLE - (time.time() - float(a["pending_since"]))))
        out.append({"name": name, "target": alias_target(spec, routes), "confirmed": a.get("confirmed"),
                    "pending": a.get("pending"), "pending_in": left, "notify": spec.get("notify") or [],
                    "handoff": spec.get("handoff") or "",
                    "candidates": [{"name": c, "known": c in routes,
                                    "online": bool(routes.get(c)) and online(routes.get(c, {}))}
                                   for c in spec["candidates"]]})
    return out


def switch_rows(limit=10):
    """The last confirmed switches, newest first (from logs/alias_switch.log)."""
    lf = LOGS / SWITCH_LOG
    if not lf.exists():
        return []
    out = []
    for line in lf.read_text(encoding="utf-8", errors="replace").splitlines()[-limit:]:
        parts = line.split(" ", 2)
        out.append({"id": parts[0], "t": parts[1] if len(parts) > 1 else "", "text": line})
    return out[::-1]


def delivery_snapshot(routes):
    """{box: {"reminded": set(file), "failed": set(file)}} read once from the existing ledgers.

    "Reminded" means the channel accepted the reminder, per channel: the Claude `.seen` file, the
    OpenCode plugin's DELIVERED rows, and the postman's `.woken.json` (accept records). `.delivered.json`
    is deliberately not read — it also holds the 20-minute fallback marks, which are not reminders —
    and FAILED_FINAL is never counted as delivered. One snapshot feeds both the counts and the list so
    the panel cannot show two different stories. No new state store.
    """
    out = {}
    woken = {}
    wf = HOME / ".woken.json"
    if wf.exists():
        try:
            data = json.loads(wf.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                woken = data
        except ValueError:
            woken = {}
    oc = {}
    ledger = HOME / "opencode_delivered.jsonl"
    if ledger.exists():
        for line in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("box") and e.get("file"):
                oc.setdefault(e["box"], []).append((e.get("result"), e["file"]))
    for name, r in routes.items():
        method = r.get("methods", ["notify"])[0]
        reminded, failed = set(), set()
        if method == "claude_hook":
            seen = read_lines(HOME / name / ".seen")
            reminded = {p.name for p in pending(name) if str(p) in seen}
        elif method == "opencode_plugin":
            for result, fname in oc.get(name, []):
                if result == "DELIVERED":
                    reminded.add(fname)
                elif result == "FAILED_FINAL":
                    failed.add(fname)
        else:
            reminded = {Path(k).name for k in woken
                        if Path(k).parent.parent.name == name and (HOME / name / "inbox" / Path(k).name).is_file()}
        out[name] = {"reminded": reminded, "failed": failed}
    return out


def mail_state(name, snap):
    """One letter's delivery status plus the box's three counts, from the same snapshot."""
    s = snap.get(name, {"reminded": set(), "failed": set()})
    letters, counts = [], {"waiting": 0, "reminded": 0, "failed": 0}
    for p in pending(name):
        if p.name in s["reminded"]:
            status = "reminded"
        elif p.name in s["failed"]:
            status = "failed"
        else:
            status = "waiting"
        counts[status] += 1
        letters.append({"file": p.name, "status": status,
                        "subject": field(p, "事由").replace("事由：", "")[:60],
                        "from": field(p, "来源").replace("来源：", "").split("（")[0][:30]})
    return letters, counts


def panel_state():
    rows = []
    full = load_routes()
    routes = boxes(full)
    snap = delivery_snapshot(routes)
    for name, r in routes.items():
        m = r.get("methods", ["notify"])[0]
        letters, counts = mail_state(name, snap)
        rows.append({
            "name": name, "app": APP.get(m, m), "method": m, "who": r.get("who", ""),
            "online": online(r),
            "ident": r.get("claude_title") or r.get("session_id") or r.get("thread_id") or "",
            "pending": letters, "counts": counts,
            "acks": recent_acks(name),
        })
    lines = []
    for f in ("postman.log", "claude_hook.log", "opencode_plugin.log"):
        lf = LOGS / f
        if lf.exists():
            for line in lf.read_text(encoding="utf-8", errors="replace").splitlines()[-40:]:
                if "未登记会话" in line:
                    continue
                t = line[:19].replace("T", " ")
                if f == "opencode_plugin.log":     # ISO UTC → local
                    try:
                        t = datetime.datetime.fromisoformat(line[:23].replace("Z", "+00:00")).astimezone() \
                            .strftime("%Y-%m-%d %H:%M:%S")
                        line = t + line[24:]
                    except ValueError:
                        pass
                lines.append((t, f.split(".")[0], line[20:]))
    lines.sort()
    cfg, cfg_err = load_config()
    return {"home": str(HOME), "boxes": rows, "broadcasts": broadcast_rows(),
            "groups": group_rows(routes, snap), "aliases": alias_rows(), "switches": switch_rows(),
            "config": str(CONFIG) if cfg is not None else "", "config_error": cfg_err,
            "log": [{"t": t, "src": s, "msg": m} for t, s, m in lines[-40:]][::-1]}


def cmd_panel(a):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    import webbrowser
    html = (REPO / "panel" / "index.html").read_bytes()
    port = a.port

    class H(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def _send(self, code, body, ctype="application/json; charset=utf-8"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _local(self):
            # only our own page may change things (blocks other websites from poking localhost)
            origin = self.headers.get("Origin")
            return origin in (None, f"http://127.0.0.1:{port}", f"http://localhost:{port}")

        def do_GET(self):
            if self.path in ("/", "/index.html"):
                self._send(200, html, "text/html; charset=utf-8")
            elif self.path == "/api/state":
                self._send(200, json.dumps(panel_state(), ensure_ascii=False).encode())
            else:
                self._send(404, b"{}")

        def do_POST(self):
            if self.path not in ("/api/status", "/api/clear") or not self._local() \
                    or self.headers.get("Content-Type", "").split(";")[0] != "application/json":
                return self._send(403, b'{"ok":false}')
            message = ""
            try:
                d = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                if self.path == "/api/clear":
                    name = str(d["name"])
                    ok = name in boxes(load_routes())
                    if ok:
                        _, n = clear_backlog(name)
                        log("postman.log", f"面板：清空 {name} 积压 {n} 封")
                elif d.get("group"):        # group button: same transition rules, same origin check
                    set_group_status("@" + str(d["group"]), str(d["status"]), quiet=True)
                    ok = True
                else:
                    name = str(d["name"])
                    ok = apply_status(name, str(d["status"]))
                    if ok:
                        log("postman.log", f"面板：{name} 设为{'在线' if d['status'] == 'online' else '离线'}")
            except (ValueError, KeyError):
                ok = False
            except SystemExit as e:        # an unknown group or a missing member: say why, change nothing
                ok, message = False, str(e)
            self._send(200 if ok else 400, json.dumps({"ok": ok, "error": message if not ok else ""}).encode())

    try:
        srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    except OSError:
        # an older panel still holding the port: replace it; anything else: explain instead of a traceback
        r = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"], capture_output=True, text=True)
        old = []
        for x in r.stdout.split():
            cmd = subprocess.run(["ps", "-o", "command=", "-p", x], capture_output=True, text=True).stdout
            if "postoffice" in cmd and " panel" in cmd and int(x) != os.getpid():
                old.append(int(x))
        if not old:
            sys.exit(f"端口 {port} 被别的程序占用了，换一个：postoffice panel --port 8766")
        for pid in old:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        print(f"已关闭旧面板（pid {', '.join(map(str, old))}），换成新版")
        for _ in range(20):
            time.sleep(0.25)
            try:
                srv = ThreadingHTTPServer(("127.0.0.1", port), H)
                break
            except OSError:
                continue
        else:
            sys.exit(f"旧面板没能关掉，端口 {port} 仍被占用")
    url = f"http://127.0.0.1:{port}/"
    print(f"联络总站面板：{url}（Ctrl+C 关闭）", flush=True)
    if not a.no_open:
        webbrowser.open(url)
    srv.serve_forever()

def group_or_box(a, status):
    """`online`/`offline`: @GROUP switches the whole group, a plain name stays a single mailbox."""
    if a.name.startswith("@"):
        set_group_status(a.name, status)
    else:
        set_status(a.name, status)
    return 0


