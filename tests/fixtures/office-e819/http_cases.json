{
  "baseline": "e819f0e（本地候选 worktree <local worktree>，postoffice 同版本行数见 CHAPTER_0）",
  "method": "隔离 temp HOME＋匿名数据实跑：POSTOFFICE_HOME=<temp> POSTOFFICE_NO_NOTIFY=1 POSTOFFICE_POLL=1 postoffice panel --no-open --port <p>，curl 逐条；临时路径已抹为 <HOME>",
  "anon_fixture": {
    "boxes": [
      "panelop(operator,notify)",
      "box_a(notify)",
      "box_b(notify)",
      "box_unlisted(notify,不在组织树)",
      "box_c(opencode_plugin)"
    ],
    "aliases": [
      "office.design(候选 box_a,scope=project anonproj)",
      "office.worker(候选 box_b)",
      "office.missing(候选 box_unlisted)"
    ],
    "pending_states": {
      "box_a": "waiting+reminded 各一",
      "box_c": "failed 一"
    },
    "org_tree": "panel.organization={members:[box_a,box_b],label:匿名团队}（box_unlisted/box_c 已登记但未编入——API 不标记，前端自行差集）"
  },
